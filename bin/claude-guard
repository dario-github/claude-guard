#!/usr/bin/env bash
set -euo pipefail

VERSION="3.0.0"

CONFIG_FILE="${CLAUDE_GUARD_CONFIG:-${SAFE_CLAUDE_CONFIG:-$HOME/.safe-claude-official.json}}"
OFFICIAL_SETTINGS_OVERRIDE="${CLAUDE_GUARD_SETTINGS:-}"
OFFICIAL_CONFIG_DIR=""
OFFICIAL_SETTINGS=""
CA_CERT_FILE="${CLAUDE_GUARD_CA_CERT:-/etc/ssl/cert.pem}"
CLAUDE_PROXY_URL="${CLAUDE_GUARD_PROXY:-${CLAUDE_OFFICIAL_PROXY:-http://127.0.0.1:7897}}"
NO_PROXY_LIST="${CLAUDE_GUARD_NO_PROXY:-${CLAUDE_OFFICIAL_NO_PROXY:-127.0.0.1,localhost,::1,.local}}"
IP_CHECK_RETRIES="${CLAUDE_GUARD_IP_RETRIES:-${CLAUDE_OFFICIAL_IP_RETRIES:-3}}"
IP_CHECK_URLS="${CLAUDE_GUARD_IP_CHECK_URLS:-${CLAUDE_OFFICIAL_IP_CHECK_URLS:-https://api.anthropic.com/cdn-cgi/trace}}"
TLS_CHECK_RETRIES="${CLAUDE_GUARD_TLS_RETRIES:-${CLAUDE_OFFICIAL_TLS_RETRIES:-3}}"
PLATFORM_TLS_MODE="${CLAUDE_GUARD_PLATFORM_TLS_MODE:-${CLAUDE_OFFICIAL_PLATFORM_TLS_MODE:-warn}}"
ASSUME_YES="${CLAUDE_GUARD_ASSUME_YES:-0}"
WATCHDOG_ENABLED="${CLAUDE_GUARD_WATCHDOG:-1}"
WATCHDOG_DRY_RUN="${CLAUDE_GUARD_WATCHDOG_DRY_RUN:-1}"
IP_INTERVAL="${CLAUDE_GUARD_IP_INTERVAL:-60}"
API_INTERVAL="${CLAUDE_GUARD_API_INTERVAL:-180}"
RECOVERY_INTERVAL="${CLAUDE_GUARD_RECOVERY_INTERVAL:-30}"
WATCHDOG_TICK_SECONDS="${CLAUDE_GUARD_WATCHDOG_TICK_SECONDS:-5}"
WAKE_GAP_SECONDS="${CLAUDE_GUARD_WAKE_GAP_SECONDS:-120}"
IP_BAD_THRESHOLD="${CLAUDE_GUARD_IP_BAD_THRESHOLD:-2}"
API_BAD_THRESHOLD="${CLAUDE_GUARD_API_BAD_THRESHOLD:-3}"
RESUME_GOOD_THRESHOLD="${CLAUDE_GUARD_RESUME_GOOD_THRESHOLD:-2}"
KILL_AFTER_PAUSE_SECONDS="${CLAUDE_GUARD_KILL_AFTER_PAUSE_SECONDS:-}"
LOG_FILE="${CLAUDE_GUARD_LOG_FILE:-$HOME/.claude-guard/guard.log}"
LOG_MAX_BYTES="${CLAUDE_GUARD_LOG_MAX_BYTES:-1048576}"
NOTIFY_OVERRIDE_SET=0
if [ "${CLAUDE_GUARD_NOTIFY+x}" = "x" ]; then
  NOTIFY_OVERRIDE_SET=1
fi
NOTIFY_ENABLED="${CLAUDE_GUARD_NOTIFY:-0}"
DRY_RUN_STDERR="${CLAUDE_GUARD_DRY_RUN_STDERR:-0}"
FINGERPRINT_MODE="${CLAUDE_GUARD_FINGERPRINT_MODE:-fail-active}"
LEGACY_PROFILE_MODE="${CLAUDE_GUARD_LEGACY_PROFILE_MODE:-warn}"
STRICT_LIFECYCLE=0
LIFECYCLE_BLOCK=0
WATCHDOG_STRICT=0
WATCHDOG_STRICT_SIGNAL="TERM"
MIHOMO_STRICT=0
MIHOMO_FINDINGS=0
DOCTOR_BLOCK=0
DOCTOR_ENV_REPORTED=0
MIHOMO_KIND=""
MIHOMO_SOCKET=""
MIHOMO_HTTP_BASE=""
MIHOMO_SECRET=""
MIHOMO_SELECTED_NODE=""
MIHOMO_CONN_JSON=""
LAUNCH_BLOCK_FILE="${CLAUDE_GUARD_LAUNCH_BLOCK_FILE:-$HOME/.claude-guard/launch-block}"
CURRENT_IP_SOURCE=""
SETTINGS_RISK_RE='ANTHROPIC_(BASE_URL|AUTH_TOKEN|API_KEY|CUSTOM_HEADERS|AWS_BASE_URL|BEDROCK_BASE_URL|VERTEX_BASE_URL|FOUNDRY_BASE_URL)|apiKeyHelper|PROXY_MANAGED|CLAUDE_CODE_USE_(GATEWAY|BEDROCK|VERTEX|FOUNDRY|ANTHROPIC_AWS|MANTLE)|CLAUDE_CODE_PROCESS_WRAPPER|processWrapper|CLAUDE_CODE_RETRY_WATCHDOG|CLAUDE_CODE_ATTRIBUTION_HEADER|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NODE_EXTRA_CA_CERTS|SSL_CERT_FILE|CLAUDE_CODE_CERT_STORE|CLAUDE_CONFIG_DIR'
PRECHECK_ONLY=0
COMMAND_MODE="run"
STATUS_JSON=0
UI_MODE="${CLAUDE_GUARD_UI:-auto}"
UI_ENABLED=0
UI_DYNAMIC=0
UI_UNICODE=0
UI_TOTAL=8
UI_INDEX=0
UI_CURRENT_STEP=""
UI_STEP_NOTES=""
UI_STEP_WARNINGS=""
UI_STEP_WARNING_COUNT=0
UI_WARNING_TOTAL=0
UI_STARTED=0
UI_COMPLETE=0
UI_STARTED_AT=0
UI_RED=""
UI_GREEN=""
UI_YELLOW=""
UI_CYAN=""
UI_DIM=""
UI_RESET=""

usage() {
  cat <<'EOF'
Claude 守护 - startup guard for official Claude Code

Usage:
  claude-guard [--precheck-only] [claude args...]
  claude-guard status [--json]
  claude-guard doctor
  claude-guard diagnose
  claude-guard --version
  claude-guard --help

Environment:
  CLAUDE_GUARD_CONFIG        Safe config JSON. Default: ~/.safe-claude-official.json
  CLAUDE_GUARD_SETTINGS      Override the settings file from config_dir.
  CLAUDE_GUARD_PROXY         Required proxy URL. Default: http://127.0.0.1:7897
  CLAUDE_GUARD_NO_PROXY      NO_PROXY list. Default: 127.0.0.1,localhost,::1,.local
  CLAUDE_GUARD_ASSUME_YES    Set to 1 to skip the final Enter prompt when IP is allowed.
  CLAUDE_GUARD_IP_CHECK_URLS Space-separated egress probe endpoints. Both bare-IP
                             and /cdn-cgi/trace response bodies are accepted.
                             Default: https://api.anthropic.com/cdn-cgi/trace
  CLAUDE_GUARD_UI             auto, always, or never. Default: auto.
                              auto renders the visual preflight only in an interactive terminal.
  NO_COLOR                   Disable ANSI colors while keeping the visual preflight layout.
  CLAUDE_GUARD_WATCHDOG      Set to 0 to disable runtime guarding. Default: 1
  CLAUDE_GUARD_STRICT_LIFECYCLE
                              Default: 0. Lifecycle gaps warn only. Set to 1 to
                              fail closed after the network checks.
  CLAUDE_GUARD_WATCHDOG_DRY_RUN
                              Default: 1. Logs would-pause/would-resume and leaves
                              existing sessions running.
  CLAUDE_GUARD_WATCHDOG_STRICT
                              Default: 0. Set to 1 to signal an existing session
                              when egress drifts. Does not change the default.
  CLAUDE_GUARD_WATCHDOG_STRICT_SIGNAL
                              TERM or STOP. Default: TERM. Used only with strict.
  CLAUDE_GUARD_MIHOMO        auto, on, or off. Default: auto (doctor only).
  CLAUDE_GUARD_MIHOMO_API    unix:///path.sock or http://127.0.0.1:9090.
  CLAUDE_GUARD_MIHOMO_STRICT Default: 0. Set to 1 to fail doctor on DIRECT,
                              uncovered required domains, or strict-route off.
  CLAUDE_GUARD_RECOVERY_INTERVAL
                              Seconds between paired IP/API probes while degraded. Default: 30.
  CLAUDE_GUARD_DRY_RUN_STDERR
                              Set to 1 to print dry-run pause/resume notices to stderr.
  CLAUDE_GUARD_FINGERPRINT_MODE
                              off, warn, fail-active, or strict. Default: fail-active.
  CLAUDE_GUARD_LEGACY_PROFILE_MODE
                              off, warn, or strict for ~/.claude contamination. Default: warn.
  CLAUDE_GUARD_LOG_FILE      Default: ~/.claude-guard/guard.log
  CLAUDE_GUARD_LOG_MAX_BYTES Rotate to guard.log.1 after this size. Default: 1048576.
  CLAUDE_GUARD_NOTIFY        Set to 1 for macOS pause/resume notifications.
                              If unset, reads boolean `notify` from the safe config. Default: off.

Lifecycle policy:
  Default is warn-only. Hooks, plugins, background sessions, workflows, cron,
  and Remote Control may stay enabled. Set CLAUDE_GUARD_STRICT_LIFECYCLE=1
  or "strict_lifecycle": true to restore fail-closed after network checks.
  Egress allowlist, proxy CONNECT, TLS issuer, and IPv6 stay hard gates and
  run even when settings are absent. Route, credential, and certificate
  overrides still fail closed. Client version and SHA-256 are optional pins.

The config file must contain:
  {
    "command": "/absolute/path/to/original/claude",
    "config_dir": "/absolute/path/to/versioned/profile",
    "allowed_ips": ["x.x.x.x"],
    "allowed_cidrs": ["x.x.x.0/24"]
  }
EOF
}

case "${1:-}" in
  status)
    COMMAND_MODE="status"
    shift
    if [ "${1:-}" = "--json" ]; then
      STATUS_JSON=1
      shift
    fi
    if [ "$#" -gt 0 ]; then
      printf 'status 不接受额外参数: %s\n' "$*" >&2
      exit 2
    fi
    ;;
  doctor)
    COMMAND_MODE="doctor"
    PRECHECK_ONLY=1
    shift
    if [ "$#" -gt 0 ]; then
      printf 'doctor 不接受额外参数: %s\n' "$*" >&2
      exit 2
    fi
    ;;
  diagnose)
    COMMAND_MODE="diagnose"
    shift
    if [ "$#" -gt 0 ]; then
      printf 'diagnose 不接受额外参数: %s\n' "$*" >&2
      exit 2
    fi
    ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      printf 'claude-guard %s\n' "$VERSION"
      exit 0
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --precheck-only)
      PRECHECK_ONLY=1
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf '缺少依赖命令: %s\n' "$1" >&2
    case "$1" in
      curl) printf '安装建议: macOS 通常自带 curl；如缺失可执行 brew install curl\n' >&2 ;;
      jq) printf '安装建议: brew install jq\n' >&2 ;;
    esac
    exit 127
  fi
}

require_cmd jq
case "$COMMAND_MODE" in
  status|diagnose) ;;
  *) require_cmd curl ;;
esac

configure_ui() {
  case "$UI_MODE" in
    auto)
      if [ -t 2 ] && [ "${TERM:-}" != "dumb" ]; then
        UI_ENABLED=1
      fi
      ;;
    always)
      UI_ENABLED=1
      ;;
    never)
      UI_ENABLED=0
      ;;
    *)
      printf 'CLAUDE_GUARD_UI 只能是 auto、always 或 never，当前是: %s\n' "$UI_MODE" >&2
      exit 2
      ;;
  esac

  if [ "$UI_ENABLED" -eq 1 ] && [ -t 2 ] && [ "${TERM:-}" != "dumb" ]; then
    UI_DYNAMIC=1
  fi

  if [ "$UI_ENABLED" -eq 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then
    UI_RED=$'\033[31m'
    UI_GREEN=$'\033[32m'
    UI_YELLOW=$'\033[33m'
    UI_CYAN=$'\033[36m'
    UI_DIM=$'\033[2m'
    UI_RESET=$'\033[0m'
  fi

  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) UI_UNICODE=1 ;;
  esac
}

ui_progress_bar() {
  local completed="$1"
  local width=16
  local filled empty i bar=""

  filled=$((completed * width / UI_TOTAL))
  empty=$((width - filled))
  i=0
  while [ "$i" -lt "$filled" ]; do
    if [ "$UI_UNICODE" -eq 1 ]; then
      bar="${bar}█"
    else
      bar="${bar}#"
    fi
    i=$((i + 1))
  done
  i=0
  while [ "$i" -lt "$empty" ]; do
    if [ "$UI_UNICODE" -eq 1 ]; then
      bar="${bar}░"
    else
      bar="${bar}-"
    fi
    i=$((i + 1))
  done
  printf '%s' "$bar"
}

ui_icon() {
  local kind="$1"

  if [ "$UI_UNICODE" -eq 1 ]; then
    case "$kind" in
      pass) printf '✓' ;;
      warn) printf '!' ;;
      fail) printf '×' ;;
      active) printf '…' ;;
    esac
  else
    case "$kind" in
      pass) printf 'OK' ;;
      warn) printf '!' ;;
      fail) printf 'X' ;;
      active) printf '..' ;;
    esac
  fi
}

ui_header() {
  local title_separator="-"

  [ "$UI_ENABLED" -eq 1 ] || return 0
  [ "$UI_UNICODE" -eq 1 ] && title_separator="·"
  UI_STARTED=1
  UI_STARTED_AT="$SECONDS"
  printf '\n%sClaude Guard %s Official Preflight%s  %sv%s%s\n' \
    "$UI_CYAN" "$title_separator" "$UI_RESET" "$UI_DIM" "$VERSION" "$UI_RESET" >&2
  printf '%s  profile  %s%s\n' "$UI_DIM" "$OFFICIAL_CONFIG_DIR" "$UI_RESET" >&2
  printf '%s  route    %s%s\n\n' "$UI_DIM" "$CLAUDE_PROXY_URL" "$UI_RESET" >&2
  trap 'ui_exit_trap "$?"' EXIT
}

ui_step_start() {
  local label="$1"
  local bar icon

  UI_INDEX=$((UI_INDEX + 1))
  UI_CURRENT_STEP="$label"
  UI_STEP_NOTES=""
  UI_STEP_WARNINGS=""
  UI_STEP_WARNING_COUNT=0
  [ "$UI_ENABLED" -eq 1 ] || return 0

  bar="$(ui_progress_bar "$UI_INDEX")"
  icon="$(ui_icon active)"
  printf '  %s%s%s  [%s] %s/%s  %s\n' \
    "$UI_CYAN" "$icon" "$UI_RESET" "$bar" "$UI_INDEX" "$UI_TOTAL" "$label" >&2
}

ui_note() {
  local format="$1"
  local message
  shift

  # shellcheck disable=SC2059
  printf -v message "$format" "$@"
  if [ "$UI_ENABLED" -eq 1 ]; then
    if [ -n "$UI_STEP_NOTES" ]; then
      UI_STEP_NOTES="${UI_STEP_NOTES}"$'\n'"$message"
    else
      UI_STEP_NOTES="$message"
    fi
  else
    printf '%s\n' "$message"
  fi
}

ui_visual_note() {
  [ "$UI_ENABLED" -eq 1 ] || return 0
  ui_note "$@"
}

ui_warn() {
  local format="$1"
  local message
  shift

  # shellcheck disable=SC2059
  printf -v message "$format" "$@"
  if [ "$UI_ENABLED" -eq 1 ]; then
    if [ -n "$UI_STEP_WARNINGS" ]; then
      UI_STEP_WARNINGS="${UI_STEP_WARNINGS}"$'\n'"$message"
    else
      UI_STEP_WARNINGS="$message"
    fi
    UI_STEP_WARNING_COUNT=$((UI_STEP_WARNING_COUNT + 1))
    UI_WARNING_TOTAL=$((UI_WARNING_TOTAL + 1))
  else
    printf '%s\n' "$message" >&2
  fi
}

ui_render_detail() {
  local kind="$1"
  local content="$2"
  local color="$UI_DIM"
  local prefix=" "
  local line

  [ -n "$content" ] || return 0
  if [ "$kind" = "warn" ]; then
    color="$UI_YELLOW"
    prefix="!"
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '      %s%s %s%s\n' "$color" "$prefix" "$line" "$UI_RESET" >&2
  done <<EOF
$content
EOF
}

ui_step_finish() {
  local bar icon color status="pass"

  [ "$UI_ENABLED" -eq 1 ] || return 0
  if [ "$UI_STEP_WARNING_COUNT" -gt 0 ]; then
    status="warn"
  fi

  bar="$(ui_progress_bar "$UI_INDEX")"
  icon="$(ui_icon "$status")"
  color="$UI_GREEN"
  [ "$status" = "warn" ] && color="$UI_YELLOW"

  if [ "$UI_DYNAMIC" -eq 1 ]; then
    printf '\033[1A\r\033[2K' >&2
  fi
  printf '  %s%s%s  [%s] %s/%s  %s\n' \
    "$color" "$icon" "$UI_RESET" "$bar" "$UI_INDEX" "$UI_TOTAL" "$UI_CURRENT_STEP" >&2
  ui_render_detail note "$UI_STEP_NOTES"
  ui_render_detail warn "$UI_STEP_WARNINGS"
}

ui_finish() {
  local elapsed=0
  local icon message

  UI_COMPLETE=1
  [ "$UI_ENABLED" -eq 1 ] || return 0
  elapsed=$((SECONDS - UI_STARTED_AT))
  icon="$(ui_icon pass)"
  message="预检已通过"
  if [ "$UI_WARNING_TOTAL" -gt 0 ]; then
    message="${message}，含 ${UI_WARNING_TOTAL} 条警告"
  fi
  printf '\n  %s%s  %s%s  %s8/8%s  %s%ss%s\n' \
    "$UI_GREEN" "$icon" "$message" "$UI_RESET" \
    "$UI_DIM" "$UI_RESET" "$UI_DIM" "$elapsed" "$UI_RESET" >&2
}

ui_exit_trap() {
  local status="$1"
  local icon

  if [ "$UI_ENABLED" -eq 1 ] && [ "$UI_STARTED" -eq 1 ] &&
     [ "$UI_COMPLETE" -ne 1 ] && [ "$status" -ne 0 ]; then
    icon="$(ui_icon fail)"
    printf '\n  %s%s  预检未通过%s  %s%s/%s · %s · exit=%s%s\n' \
      "$UI_RED" "$icon" "$UI_RESET" "$UI_DIM" "$UI_INDEX" "$UI_TOTAL" \
      "${UI_CURRENT_STEP:-初始化}" "$status" "$UI_RESET" >&2
  fi
}

configure_ui

resolve_path() {
  local path="$1"

  if command -v realpath >/dev/null 2>&1; then
    realpath "$path" 2>/dev/null || printf '%s\n' "$path"
  else
    printf '%s\n' "$path"
  fi
}

clean_env() {
  env -i \
    HOME="$HOME" \
    USER="${USER:-user}" \
    PATH="$PATH" \
    TERM="${TERM:-xterm-256color}" \
    LANG="${LANG:-en_US.UTF-8}" \
    LC_ALL="${LC_ALL:-en_US.UTF-8}" \
    SHELL="${SHELL:-/bin/zsh}" \
    "$@"
}

official_net_env() {
  env -i \
    HOME="$HOME" \
    USER="${USER:-user}" \
    PATH="$PATH" \
    TERM="${TERM:-xterm-256color}" \
    LANG="${LANG:-en_US.UTF-8}" \
    LC_ALL="${LC_ALL:-en_US.UTF-8}" \
    SHELL="${SHELL:-/bin/zsh}" \
    HTTP_PROXY="$CLAUDE_PROXY_URL" \
    HTTPS_PROXY="$CLAUDE_PROXY_URL" \
    ALL_PROXY="$CLAUDE_PROXY_URL" \
    http_proxy="$CLAUDE_PROXY_URL" \
    https_proxy="$CLAUDE_PROXY_URL" \
    all_proxy="$CLAUDE_PROXY_URL" \
    NO_PROXY="$NO_PROXY_LIST" \
    no_proxy="$NO_PROXY_LIST" \
    SSL_CERT_FILE="$CA_CERT_FILE" \
    NODE_EXTRA_CA_CERTS="$CA_CERT_FILE" \
    "$@"
}

sha256_file() {
  local file="$1"

  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
    return 0
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
    return 0
  fi

  printf '缺少 SHA-256 校验工具；需要 shasum 或 sha256sum。\n' >&2
  return 1
}

check_client_identity() {
  local claude_bin="$1"
  local resolved_bin expected_version expected_sha expected_team
  local actual_version actual_sha signature team

  resolved_bin="$(resolve_path "$claude_bin")"
  expected_version="$(jq -r '.client_version // empty' "$CONFIG_FILE")"
  expected_sha="$(jq -r '.client_sha256 // empty' "$CONFIG_FILE")"
  expected_team="$(jq -r '.client_macos_team_id // empty' "$CONFIG_FILE")"

  if [ -n "$expected_version" ]; then
    actual_version="$(clean_env DISABLE_UPDATES=1 "$resolved_bin" --version 2>/dev/null | awk 'NR == 1 {print $1}')"
    if [ "$actual_version" != "$expected_version" ]; then
      printf '客户端版本校验失败：期望 %s，实际 %s。\n' "$expected_version" "${actual_version:-unknown}" >&2
      exit 12
    fi
  else
    actual_version="unpinned"
  fi

  if [ -n "$expected_sha" ]; then
    actual_sha="$(sha256_file "$resolved_bin")"
    if [ "$actual_sha" != "$expected_sha" ]; then
      printf '客户端 SHA-256 校验失败：%s\n' "$resolved_bin" >&2
      exit 12
    fi
  else
    actual_sha="unpinned"
  fi

  if [ -n "$expected_team" ]; then
    if [ "$(uname -s)" != "Darwin" ] || ! command -v codesign >/dev/null 2>&1; then
      printf '客户端签名校验失败：配置要求 macOS Team ID，但当前平台无法使用 codesign。\n' >&2
      exit 12
    fi
    if ! codesign --verify --strict "$resolved_bin" >/dev/null 2>&1; then
      printf '客户端签名校验失败：codesign 未通过: %s\n' "$resolved_bin" >&2
      exit 12
    fi
    signature="$(codesign -dv --verbose=4 "$resolved_bin" 2>&1 || true)"
    team="$(printf '%s\n' "$signature" | sed -n 's/^TeamIdentifier=//p' | head -1)"
    if [ "$team" != "$expected_team" ]; then
      printf '客户端签名校验失败：期望 Team ID %s，实际 %s。\n' "$expected_team" "${team:-unknown}" >&2
      exit 12
    fi
  else
    team="unpinned"
  fi

  ui_note '客户端身份校验通过：version=%s sha256=%s team=%s' \
    "$actual_version" "${actual_sha:0:12}" "$team"
}

validate_json_file() {
  local file="$1"
  local label="$2"

  if ! jq empty "$file" >/dev/null 2>&1; then
    printf '%s 不是有效 JSON，已拒绝启动: %s\n' "$label" "$file" >&2
    exit 5
  fi
}

settings_risk_paths() {
  local file="$1"

  jq -r --arg re "$SETTINGS_RISK_RE" '
    paths(scalars) as $p
    | ($p | map(tostring) | join(".")) as $path
    | (getpath($p) | tostring) as $value
    | select(
        ($path | test($re; "i"))
        or ($value | test("127\\.0\\.0\\.1:15721|PROXY_MANAGED"; "i"))
      )
    | $path
  ' "$file" | sort -u
}

check_blocked_plugins() {
  local file="$1"
  local label="$2"
  local plugin

  while IFS= read -r plugin; do
    [ -n "$plugin" ] || continue
    if jq -e --arg plugin "$plugin" '(.enabledPlugins // {})[$plugin] == true' "$file" >/dev/null; then
      printf '%s 启用了会脱离终端运行的受阻插件，已拒绝启动: %s (%s)\n' \
        "$label" "$plugin" "$file" >&2
      exit 13
    fi
  done <<EOF
$(jq -r '.blocked_plugins // [] | .[] | select(type == "string")' "$CONFIG_FILE")
EOF
}

resolve_strict_lifecycle() {
  local configured="0"

  if [ "${CLAUDE_GUARD_STRICT_LIFECYCLE+x}" = "x" ]; then
    configured="$CLAUDE_GUARD_STRICT_LIFECYCLE"
  elif [ -f "$CONFIG_FILE" ] && jq -e 'type == "object" and has("strict_lifecycle")' "$CONFIG_FILE" >/dev/null 2>&1; then
    if jq -e '(.strict_lifecycle | type) != "boolean"' "$CONFIG_FILE" >/dev/null 2>&1; then
      printf '配置中的 strict_lifecycle 必须是 true 或 false。\n' >&2
      exit 2
    fi
    configured="$(jq -r 'if .strict_lifecycle == true then "1" else "0" end' "$CONFIG_FILE")"
  fi

  case "$configured" in
    1|true|TRUE|yes|YES) STRICT_LIFECYCLE=1 ;;
    0|false|FALSE|no|NO|"") STRICT_LIFECYCLE=0 ;;
    *)
      printf 'CLAUDE_GUARD_STRICT_LIFECYCLE 只能是 0 或 1，当前是: %s\n' "$configured" >&2
      exit 2
      ;;
  esac
}

resolve_watchdog_strict() {
  local configured="${CLAUDE_GUARD_WATCHDOG_STRICT:-0}"
  local signal="${CLAUDE_GUARD_WATCHDOG_STRICT_SIGNAL:-TERM}"

  case "$configured" in
    1|true|TRUE|yes|YES) WATCHDOG_STRICT=1 ;;
    0|false|FALSE|no|NO|"") WATCHDOG_STRICT=0 ;;
    *)
      printf 'CLAUDE_GUARD_WATCHDOG_STRICT 只能是 0 或 1，当前是: %s\n' "$configured" >&2
      exit 2
      ;;
  esac

  case "$signal" in
    TERM|term) WATCHDOG_STRICT_SIGNAL="TERM" ;;
    STOP|stop) WATCHDOG_STRICT_SIGNAL="STOP" ;;
    *)
      printf 'CLAUDE_GUARD_WATCHDOG_STRICT_SIGNAL 只能是 TERM 或 STOP，当前是: %s\n' "$signal" >&2
      exit 2
      ;;
  esac
}

apply_lifecycle_gap() {
  local headline="$1"
  local details="$2"
  local item

  if [ "$STRICT_LIFECYCLE" = "1" ]; then
    printf '%s\n' "$headline" >&2
    if [ -n "$details" ]; then
      printf '%s\n' "$details" | sed 's/^/  - /' >&2
    fi
    LIFECYCLE_BLOCK=1
    return 0
  fi

  ui_warn '%s' "$headline"
  if [ -n "$details" ]; then
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      ui_warn '生命周期警告：%s' "$item"
    done <<EOF
$details
EOF
  fi
}

check_official_settings_policy() {
  local missing risk_paths pinned_model

  if [ "$STRICT_LIFECYCLE" = "1" ]; then
    ui_note '生命周期模式：strict。能力项不满足时，网络检查完成后拒绝启动。'
  else
    ui_note '生命周期模式：warn。hooks、插件和后台能力默认不拦截。'
  fi

  if [ ! -f "$OFFICIAL_SETTINGS" ]; then
    apply_lifecycle_gap \
      "官方 settings 不存在，生命周期策略无法核对: ${OFFICIAL_SETTINGS}" \
      ""
    ui_note '网络检查（出口白名单、代理隧道、TLS、IPv6）仍会执行。'
    return 0
  fi

  validate_json_file "$OFFICIAL_SETTINGS" "官方 settings"

  risk_paths="$(settings_risk_paths "$OFFICIAL_SETTINGS")"
  if [ -n "$risk_paths" ]; then
    printf '官方 settings 含有路由、凭据、证书或重试策略改写，已拒绝启动: %s\n' "$OFFICIAL_SETTINGS" >&2
    printf '%s\n' "$risk_paths" | sed 's/^/  - /' >&2
    exit 5
  fi

  if jq -e '.require_unpinned_model // false' "$CONFIG_FILE" >/dev/null; then
    pinned_model="$(jq -r '.model // empty' "$OFFICIAL_SETTINGS")"
    if [ -n "$pinned_model" ]; then
      printf '官方 settings 固定 model=%s，已拒绝启动；请让新版客户端自行选择模型或使用一次性的 --model。\n' \
        "$pinned_model" >&2
      exit 6
    fi
  fi

  missing="$(jq -r '
    [
      if .disableAgentView != true then "disableAgentView=true" else empty end,
      if .disableRemoteControl != true then "disableRemoteControl=true" else empty end,
      if .disableDeepLinkRegistration != "disable" then "disableDeepLinkRegistration=disable" else empty end,
      if .disableAllHooks != true then "disableAllHooks=true" else empty end,
      if .disableWorkflows != true then "disableWorkflows=true" else empty end,
      if ((.env // {}).DISABLE_UPDATES != "1") then "env.DISABLE_UPDATES=1" else empty end,
      if ((.env // {}).CLAUDE_CODE_DISABLE_AGENT_VIEW != "1") then "env.CLAUDE_CODE_DISABLE_AGENT_VIEW=1" else empty end,
      if ((.env // {}).CLAUDE_CODE_DISABLE_CRON != "1") then "env.CLAUDE_CODE_DISABLE_CRON=1" else empty end,
      if ((.env // {}).CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF != "1") then "env.CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF=1" else empty end,
      if ((.env // {}).CLAUDE_DISABLE_ADOPT != "1") then "env.CLAUDE_DISABLE_ADOPT=1" else empty end,
      if ((.env // {}).CLAUDE_CODE_DISABLE_WORKFLOWS != "1") then "env.CLAUDE_CODE_DISABLE_WORKFLOWS=1" else empty end,
      if ((.env // {}).CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS != "0") then "env.CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS=0" else empty end,
      if ((.env // {}).CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH != "1") then "env.CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=1" else empty end,
      if ((.env // {}).CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS != "3") then "env.CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=3" else empty end,
      if ((.env // {}) | has("CLAUDE_CODE_DISABLE_BACKGROUND_TASKS")) then "remove env.CLAUDE_CODE_DISABLE_BACKGROUND_TASKS" else empty end,
      if (((.env // {}).CLAUDE_AUTO_BACKGROUND_TASKS // "") == "1") then "remove env.CLAUDE_AUTO_BACKGROUND_TASKS=1" else empty end,
      if (((.env // {}).CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS // "") == "1") then "remove env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1" else empty end,
      if (((.env // {}).CLAUDE_CODE_RETRY_WATCHDOG // "") != "") then "remove env.CLAUDE_CODE_RETRY_WATCHDOG" else empty end
    ]
    | .[]
  ' "$OFFICIAL_SETTINGS")"

  if [ -n "$missing" ]; then
    if [ "$STRICT_LIFECYCLE" = "1" ]; then
      apply_lifecycle_gap \
        "官方 settings 未满足 v${VERSION} 生命周期策略，网络检查完成后将拒绝启动: ${OFFICIAL_SETTINGS}" \
        "$missing"
    else
      apply_lifecycle_gap \
        "生命周期警告：未满足 v${VERSION} 生命周期策略，默认不拦截: ${OFFICIAL_SETTINGS}" \
        "$missing"
    fi
  else
    ui_note '生命周期策略通过：当前 settings 仍关闭脱离终端的会话、排程、工作流、Remote Control 与自动更新。'
  fi

  check_blocked_plugins "$OFFICIAL_SETTINGS" "官方 settings"
}

project_settings_files() {
  local dir="$PWD"
  local file

  while [ -n "$dir" ] && [ "$dir" != "$HOME" ]; do
    for file in "$dir/.claude/settings.json" "$dir/.claude/settings.local.json"; do
      [ -f "$file" ] && printf '%s\n' "$file"
    done
    [ "$dir" = "/" ] && break
    dir="$(dirname "$dir")"
  done
}

check_project_settings_policy() {
  local file risk_paths unsafe

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    validate_json_file "$file" "项目设置"

    risk_paths="$(settings_risk_paths "$file")"
    if [ -n "$risk_paths" ]; then
      printf '项目设置试图改写官方路由、凭据、证书或重试策略，已拒绝启动: %s\n' "$file" >&2
      printf '%s\n' "$risk_paths" | sed 's/^/  - /' >&2
      exit 13
    fi

    unsafe="$(jq -r '
      [
        if (.disableAgentView != null and .disableAgentView != true) then "disableAgentView" else empty end,
        if (.disableRemoteControl != null and .disableRemoteControl != true) then "disableRemoteControl" else empty end,
        if (.disableDeepLinkRegistration != null and .disableDeepLinkRegistration != "disable") then "disableDeepLinkRegistration" else empty end,
        if (.disableAllHooks != null and .disableAllHooks != true) then "disableAllHooks" else empty end,
        if (.disableWorkflows != null and .disableWorkflows != true) then "disableWorkflows" else empty end,
        if (((.env // {}).CLAUDE_CODE_DISABLE_AGENT_VIEW // "1") != "1") then "env.CLAUDE_CODE_DISABLE_AGENT_VIEW" else empty end,
        if (((.env // {}).CLAUDE_CODE_DISABLE_CRON // "1") != "1") then "env.CLAUDE_CODE_DISABLE_CRON" else empty end,
        if (((.env // {}).CLAUDE_CODE_DISABLE_WORKFLOWS // "1") != "1") then "env.CLAUDE_CODE_DISABLE_WORKFLOWS" else empty end,
        if ((.env // {}) | has("CLAUDE_CODE_DISABLE_BACKGROUND_TASKS")) then "env.CLAUDE_CODE_DISABLE_BACKGROUND_TASKS" else empty end,
        if (((.env // {}).CLAUDE_AUTO_BACKGROUND_TASKS // "") == "1") then "env.CLAUDE_AUTO_BACKGROUND_TASKS" else empty end,
        if (((.env // {}).CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS // "") == "1") then "env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS" else empty end
      ]
      | .[]
    ' "$file")"
    if [ -n "$unsafe" ]; then
      if [ "$STRICT_LIFECYCLE" = "1" ]; then
        apply_lifecycle_gap \
          "项目设置试图降低生命周期保护，网络检查完成后将拒绝启动: ${file}" \
          "$unsafe"
      else
        apply_lifecycle_gap \
          "生命周期警告：项目设置降低了能力限制，默认不拦截: ${file}" \
          "$unsafe"
      fi
    fi

    check_blocked_plugins "$file" "项目设置"
  done <<EOF
$(project_settings_files)
EOF
}

check_cli_policy() {
  local arg

  for arg in "$@"; do
    case "$arg" in
      --settings|--settings=*)
        printf '官方入口不允许覆盖 --settings；请修改受守护的官方 settings 文件。\n' >&2
        exit 13
        ;;
      --setting-sources|--setting-sources=*)
        printf '官方入口不允许覆盖 --setting-sources。\n' >&2
        exit 13
        ;;
      --bg|--bg=*|--background|--background=*|agents|attach|respawn)
        if [ "$STRICT_LIFECYCLE" = "1" ]; then
          apply_lifecycle_gap "后台会话已禁用；请在当前前台终端中运行 Claude。" ""
        else
          apply_lifecycle_gap "生命周期警告：命令行请求后台会话，默认不拦截: ${arg}" ""
        fi
        ;;
      --tmux|--tmux=*)
        if [ "$STRICT_LIFECYCLE" = "1" ]; then
          apply_lifecycle_gap "受守护入口不允许启动脱离当前终端的 tmux/iTerm2 会话。" ""
        else
          apply_lifecycle_gap "生命周期警告：命令行请求 tmux 会话，默认不拦截。" ""
        fi
        ;;
      --remote-control|--remote-control=*|remote-control)
        if [ "$STRICT_LIFECYCLE" = "1" ]; then
          apply_lifecycle_gap "Remote Control 已禁用；官方 Claude 必须留在受守护的前台终端中。" ""
        else
          apply_lifecycle_gap "生命周期警告：命令行请求 Remote Control，默认不拦截。" ""
        fi
        ;;
    esac
  done
}

check_model_policy() {
  local expect_model=0
  local arg model

  for arg in "$@"; do
    model=""
    if [ "$expect_model" -eq 1 ]; then
      model="$arg"
      expect_model=0
    else
      case "$arg" in
        --model)
          expect_model=1
          ;;
        --model=*)
          model="${arg#--model=}"
          ;;
      esac
    fi

    [ -n "$model" ] || continue
    if jq -e --arg model "$model" \
      '(.blocked_models // []) | index($model)' "$CONFIG_FILE" >/dev/null; then
      printf '模型 %s 位于本机 blocked_models 清单，已拒绝启动。\n' "$model" >&2
      exit 6
    fi
  done
}

# Some Schannel builds expose certificate metadata through %{certs}; older builds expose
# neither that structured data nor a legacy verbose issuer. Keep backend detection separate
# so the latter can fail with a capability-specific message instead of silently degrading.
tls_backend_is_schannel() {
  printf '%s\n' "$1" | grep -qi '^\* schannel'
}

TLS_PROBE_OUT=''
TLS_PROBE_CERTS=''
TLS_PROBE_ISSUER=''
TLS_PROBE_REASON=''
TLS_PROBE_UNSUPPORTED=0

tls_probe_once() {
  local host="$1"
  local issuer curl_status certs_file

  TLS_PROBE_OUT=''
  TLS_PROBE_CERTS=''
  TLS_PROBE_ISSUER=''
  TLS_PROBE_REASON=''
  TLS_PROBE_UNSUPPORTED=0

  if ! certs_file="$(umask 077; mktemp "${TMPDIR:-/tmp}/claude-guard-certs.XXXXXX")"; then
    TLS_PROBE_REASON="无法创建 TLS 证书元数据临时文件"
    return 1
  fi

  # Redirections are deliberately ordered left to right: verbose/error stderr stays in
  # TLS_PROBE_OUT, while write-out stdout goes only to the private temporary file.
  TLS_PROBE_OUT="$(official_net_env curl -q -4 -x "$CLAUDE_PROXY_URL" \
      --cacert "$CA_CERT_FILE" -vI -o /dev/null \
      --connect-timeout 8 --max-time 15 \
      --write-out '%{certs}' \
      "https://${host}/" 2>&1 >"$certs_file")" \
    && curl_status=0 || curl_status=$?
  TLS_PROBE_CERTS="$(<"$certs_file")"
  rm -f -- "$certs_file"

  if tls_backend_is_schannel "$TLS_PROBE_OUT" \
      && printf '%s\n' "$TLS_PROBE_OUT" | grep -qi 'unknown.*write-out.*certs'; then
    TLS_PROBE_UNSUPPORTED=1
    TLS_PROBE_REASON="当前 curl 使用 Schannel（Windows 原生）TLS 后端，但不提供 %{certs} 证书元数据，无法对 ${host} 执行 TLS/MITM 校验。这是 curl 能力限制，不是代理或配置问题；解决办法见 README 的「平台支持」一节。"
    return 1
  fi

  if [ "$curl_status" -ne 0 ]; then
    TLS_PROBE_REASON="无法连接或验证 ${host} 的证书"
    return 1
  fi

  if ! printf '%s\n' "$TLS_PROBE_OUT" |
      grep -Eq "CONNECT ${host}:443|CONNECT tunnel established|CONNECT phase completed"; then
    TLS_PROBE_REASON="${host} 没有走 ${CLAUDE_PROXY_URL} 的 HTTP CONNECT 隧道"
    return 1
  fi

  issuer="$(printf '%s\n' "$TLS_PROBE_CERTS" |
    sed -n 's/^Issuer:[[:space:]]*//p' | head -1)"
  if [ -z "$issuer" ]; then
    issuer="$(printf '%s\n' "$TLS_PROBE_OUT" |
      sed -n 's/^\*[[:space:]]*[Ii]ssuer:[[:space:]]*//p' | head -1)"
  fi
  if [ -z "$issuer" ]; then
    if tls_backend_is_schannel "$TLS_PROBE_OUT"; then
      TLS_PROBE_UNSUPPORTED=1
      TLS_PROBE_REASON="当前 curl 使用 Schannel（Windows 原生）TLS 后端，但不提供可读取的证书 issuer，无法对 ${host} 执行 TLS/MITM 校验。这是 curl 能力限制，不是代理或配置问题；解决办法见 README 的「平台支持」一节。"
      return 1
    fi
    TLS_PROBE_REASON="无法读取 ${host} 的证书 issuer"
    return 1
  fi

  case "$(printf '%s' "$issuer" | tr '[:upper:]' '[:lower:]')" in
    *charles*|*mitm*|*fiddler*|*zscaler*|*clash*|*surge*|*proxy*)
      TLS_PROBE_REASON="${host} 的证书 issuer 疑似代理/MITM: ${issuer}"
      return 1
      ;;
  esac

  TLS_PROBE_ISSUER="$issuer"
  return 0
}

check_tls_host() {
  local host="$1"
  local mode="${2:-required}"
  local out issuer reason attempt unsupported

  attempt=1
  unsupported=0
  while [ "$attempt" -le "$TLS_CHECK_RETRIES" ]; do
    if tls_probe_once "$host"; then
      issuer="$TLS_PROBE_ISSUER"
      ui_note 'TLS 预检通过：%s via %s issuer=%s' "$host" "$CLAUDE_PROXY_URL" "$issuer"
      return 0
    fi
    reason="$TLS_PROBE_REASON"
    out="$TLS_PROBE_OUT"
    unsupported="$TLS_PROBE_UNSUPPORTED"

    # 缺少证书元数据是确定性的 curl 能力限制，重试只会浪费时间。
    [ "$unsupported" -eq 0 ] || break

    if [ "$attempt" -lt "$TLS_CHECK_RETRIES" ]; then
      ui_warn 'TLS 预检重试：%s 第 %s/%s 次失败：%s' "$host" "$attempt" "$TLS_CHECK_RETRIES" "$reason"
      sleep 1
    fi
    attempt=$((attempt + 1))
  done

  if [ "$mode" = "warn" ]; then
    if [ "$unsupported" -eq 1 ]; then
      ui_warn 'TLS 预检警告：%s' "$reason"
    else
      ui_warn 'TLS 预检警告：%s 经过 %s 次尝试仍未稳定通过：%s' "$host" "$TLS_CHECK_RETRIES" "$reason"
    fi
    if [ "$UI_ENABLED" -eq 1 ]; then
      out="$(printf '%s\n' "$out" | grep -Ei 'certificate|issuer|subject|SSL|schannel|error|CONNECT' || true)"
      [ -z "$out" ] || ui_note '%s' "$out"
    else
      printf '%s\n' "$out" | grep -Ei 'certificate|issuer|subject|SSL|schannel|error|CONNECT' >&2 || true
    fi
    return 0
  fi

  if [ "$unsupported" -eq 1 ]; then
    printf 'TLS 预检失败：%s\n' "$reason" >&2
  else
    printf 'TLS 预检失败：%s 经过 %s 次尝试仍未通过：%s\n' "$host" "$TLS_CHECK_RETRIES" "$reason" >&2
  fi
  printf '%s\n' "$out" | grep -Ei 'certificate|issuer|subject|SSL|schannel|error|CONNECT' >&2 || true
  exit 7
}

check_anthropic_ipv6_blocked() {
  local out remote_ip

  if out="$(clean_env curl -q -6 -sS --cacert "$CA_CERT_FILE" -o /dev/null -w 'remote_ip=%{remote_ip} http=%{http_code}' --connect-timeout 3 --max-time 6 https://api.anthropic.com/ 2>/dev/null)"; then
    remote_ip="$(printf '%s\n' "$out" | sed -n 's/.*remote_ip=\([^ ]*\).*/\1/p')"
    case "$remote_ip" in
      ::ffff:198.18.*|::ffff:198.19.*|198.18.*|198.19.*)
        ui_note 'IPv6 预检通过：api.anthropic.com 仅返回 Mihomo/Clash fake-ip 映射 %s，不是公网 IPv6 出口。' "$remote_ip"
        return 0
        ;;
      ::ffff:*)
        ui_note 'IPv6 预检通过：api.anthropic.com 返回 IPv4-mapped 地址 %s，不是公网 IPv6 出口。' "$remote_ip"
        return 0
        ;;
    esac
    printf 'IPv6 预检失败：api.anthropic.com 仍可通过 IPv6 访问，已拒绝启动。\n' >&2
    printf '当前结果：%s\n' "$out" >&2
    printf '请先关闭 Clash/Mihomo IPv6，确保 Claude 官方链路压在 IPv4。\n' >&2
    exit 8
  fi

  ui_note 'IPv6 预检通过：api.anthropic.com IPv6 不可达，Claude 官方链路将压在 IPv4。'
}

rotate_guard_log_if_needed() {
  local size lock archive

  case "$LOG_MAX_BYTES" in
    ''|*[!0-9]*) return 0 ;;
  esac
  [ "$LOG_MAX_BYTES" -gt 0 ] || return 0
  [ -f "$LOG_FILE" ] || return 0

  size="$(wc -c <"$LOG_FILE" 2>/dev/null | tr -d '[:space:]')" || return 0
  [ "${size:-0}" -gt "$LOG_MAX_BYTES" ] || return 0

  lock="${LOG_FILE}.rotate.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    return 0
  fi

  size="$(wc -c <"$LOG_FILE" 2>/dev/null | tr -d '[:space:]')" || {
    rmdir "$lock" 2>/dev/null || true
    return 0
  }
  if [ "${size:-0}" -gt "$LOG_MAX_BYTES" ]; then
    archive="${LOG_FILE}.1"
    mv -f "$LOG_FILE" "$archive" 2>/dev/null || true
  fi
  rmdir "$lock" 2>/dev/null || true
}

log_guard() {
  local level="$1"
  local message="$2"
  local dir timestamp

  timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
  dir="$(dirname "$LOG_FILE")"
  mkdir -p "$dir"
  rotate_guard_log_if_needed
  printf '%s [%s] %s\n' "$timestamp" "$level" "$message" >>"$LOG_FILE"
}

notify_guard() {
  local message="$1"

  if [ "$NOTIFY_ENABLED" != "1" ] || ! command -v osascript >/dev/null 2>&1; then
    return 0
  fi

  osascript -e "display notification \"${message//\"/\\\"}\" with title \"Claude Guardian\"" >/dev/null 2>&1 || true
}

resolve_notification_setting() {
  local config_valid="${1:-0}"
  local configured="0"

  if [ "$NOTIFY_OVERRIDE_SET" -eq 1 ]; then
    configured="$NOTIFY_ENABLED"
  elif [ "$config_valid" -eq 1 ]; then
    if jq -e 'has("notify") and (.notify | type != "boolean")' "$CONFIG_FILE" >/dev/null; then
      printf '配置中的 notify 必须是 true 或 false。\n' >&2
      return 2
    fi
    configured="$(jq -r 'if .notify == true then "1" else "0" end' "$CONFIG_FILE")"
  fi

  case "$configured" in
    0|1) NOTIFY_ENABLED="$configured" ;;
    *)
      printf 'CLAUDE_GUARD_NOTIFY 只能是 0 或 1，当前是: %s\n' "$configured" >&2
      return 2
      ;;
  esac
}

load_visibility_config() {
  VISIBILITY_CONFIG_STATE="missing"
  VISIBILITY_CLAUDE_BIN=""
  VISIBILITY_PROFILE="$HOME/.claude-official"

  if [ -f "$CONFIG_FILE" ]; then
    if jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1; then
      VISIBILITY_CONFIG_STATE="valid"
      VISIBILITY_CLAUDE_BIN="$(jq -r '.command // empty' "$CONFIG_FILE")"
      VISIBILITY_PROFILE="$(jq -r '.config_dir // empty' "$CONFIG_FILE")"
      [ -n "$VISIBILITY_PROFILE" ] || VISIBILITY_PROFILE="$HOME/.claude-official"
      if [ -z "$VISIBILITY_CLAUDE_BIN" ]; then
        VISIBILITY_CONFIG_STATE="incomplete"
      fi
      resolve_notification_setting 1
    else
      VISIBILITY_CONFIG_STATE="invalid"
      resolve_notification_setting 0
    fi
  else
    resolve_notification_setting 0
  fi
}

visibility_display_path() {
  local path="$1"

  case "$path" in
    "$HOME") printf '~\n' ;;
    "$HOME"/*) printf '~%s\n' "${path#"$HOME"}" ;;
    *) printf '%s\n' "$path" ;;
  esac
}

visibility_log_stream() {
  if [ -f "${LOG_FILE}.1" ]; then
    cat "${LOG_FILE}.1" 2>/dev/null || true
  fi
  if [ -f "$LOG_FILE" ]; then
    cat "$LOG_FILE" 2>/dev/null || true
  fi
  return 0
}

visibility_process_rows() {
  local claude_bin="$1"
  local snapshot

  [ -n "$claude_bin" ] || return 0
  snapshot="$(ps -axo pid=,ppid=,pgid=,args= 2>/dev/null || true)"
  printf '%s\n' "$snapshot" | awk -v bin="$claude_bin" '
    {
      count += 1
      pid[count] = $1
      ppid[count] = $2
      pgid[count] = $3
      line[count] = $0
    }
    END {
      for (i = 1; i <= count; i += 1) {
        if (index(line[i], bin) > 0) {
          claude[pid[i]] = 1
        }
      }
      for (i = 1; i <= count; i += 1) {
        if (claude[ppid[i]] && line[i] ~ / bash .*claude-guard( |$)/) {
          watchdog[ppid[i]] += 1
        }
      }
      for (i = 1; i <= count; i += 1) {
        if (claude[pid[i]]) {
          printf "%s\t%s\t%s\n", pid[i], pgid[i], (watchdog[pid[i]] > 0 ? 1 : 0)
        }
      }
    }
  ' | sort -n
}

visibility_state_for_pid() {
  local target_pid="$1"
  local line state timestamp

  line="$(visibility_log_stream | awk -v pid="$target_pid" '
    $0 ~ ("pid=" pid "([^0-9]|$)") { last = $0 }
    END { print last }
  ')"
  timestamp="-"
  state="unknown"
  if [ -n "$line" ]; then
    timestamp="${line%% *}"
    case "$line" in
      *"would resume Claude"*|*"route healthy"*) state="healthy" ;;
      *"resume candidate"*) state="recovering" ;;
      *"would pause Claude"*) state="would-pause" ;;
      *"exit ip unavailable"*|*"exit ip not allowed"*|*"api path unhealthy"*|*"wake gap detected"*) state="degraded" ;;
      *"watchdog exited"*) state="exited" ;;
      *"watchdog started"*) state="observing" ;;
    esac
  fi
  printf '%s|%s\n' "$state" "$timestamp"
}

visibility_session_rows() {
  local base_rows target_pid pgid watchdog state_info state timestamp

  base_rows="$(visibility_process_rows "$VISIBILITY_CLAUDE_BIN")"
  [ -n "$base_rows" ] || return 0
  while IFS=$'\t' read -r target_pid pgid watchdog; do
    [ -n "$target_pid" ] || continue
    state_info="$(visibility_state_for_pid "$target_pid")"
    state="${state_info%%|*}"
    timestamp="${state_info#*|}"
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$target_pid" "$pgid" "$watchdog" "$state" "$timestamp"
  done <<EOF
$base_rows
EOF
}

visibility_last_event() {
  local pattern="$1"

  visibility_log_stream | awk -v pattern="$pattern" '
    $0 ~ pattern { last = $0 }
    END { print last }
  '
}

visibility_log_bytes() {
  local bytes=0 size

  if [ -f "${LOG_FILE}.1" ]; then
    size="$(wc -c 2>/dev/null <"${LOG_FILE}.1" | tr -d '[:space:]')" || size=0
    bytes=$((bytes + ${size:-0}))
  fi
  if [ -f "$LOG_FILE" ]; then
    size="$(wc -c 2>/dev/null <"$LOG_FILE" | tr -d '[:space:]')" || size=0
    bytes=$((bytes + ${size:-0}))
  fi
  printf '%s\n' "$bytes"
}

visibility_sessions_json() {
  local rows="$1"

  printf '%s\n' "$rows" | jq -R -s '
    split("\n")
    | map(select(length > 0) | split("\t"))
    | map({
        pid: (.[0] | tonumber),
        pgid: (.[1] | tonumber),
        watchdog: (.[2] == "1"),
        state: .[3],
        last_event_at: .[4]
      })
  '
}

print_status_report() {
  local rows sessions_json active_count watchdog_count mode mode_label notify_label health health_label
  local profile_display log_display log_bytes last_incident last_recovery

  load_visibility_config
  resolve_watchdog_strict
  resolve_strict_lifecycle
  rows="$(visibility_session_rows)"
  active_count="$(printf '%s\n' "$rows" | awk 'NF { count += 1 } END { print count + 0 }')"
  watchdog_count="$(printf '%s\n' "$rows" | awk -F '\t' 'NF { count += $3 } END { print count + 0 }')"
  mode="action-refused"
  mode_label="action requested (refused at launch)"
  if [ "$WATCHDOG_STRICT" = "1" ]; then
    mode="strict"
    mode_label="strict signal ${WATCHDOG_STRICT_SIGNAL}"
  elif [ "$WATCHDOG_DRY_RUN" = "1" ]; then
    mode="dry-run"
    mode_label="dry-run observation"
  fi
  notify_label="disabled"
  [ "$NOTIFY_ENABLED" = "1" ] && notify_label="enabled"
  health="idle"
  health_label="IDLE"
  if [ "$active_count" -gt 0 ]; then
    health="ok"
    health_label="OK"
    if [ "$watchdog_count" -lt "$active_count" ] || \
       printf '%s\n' "$rows" | awk -F '\t' '$4 ~ /^(degraded|would-pause|recovering|unknown|exited)$/ { found = 1 } END { exit !found }'; then
      health="warn"
      health_label="WARN"
    fi
  fi
  profile_display="$(visibility_display_path "$VISIBILITY_PROFILE")"
  log_display="$(visibility_display_path "$LOG_FILE")"
  log_bytes="$(visibility_log_bytes)"
  last_incident="$(visibility_last_event 'would pause Claude|exit ip unavailable|exit ip not allowed|api path unhealthy|wake gap detected')"
  last_recovery="$(visibility_last_event 'would resume Claude|route healthy')"

  if [ "$STATUS_JSON" -eq 1 ]; then
    sessions_json="$(visibility_sessions_json "$rows")"
    jq -n \
      --arg version "$VERSION" \
      --arg mode "$mode" \
      --arg health "$health" \
      --arg config_state "$VISIBILITY_CONFIG_STATE" \
      --arg proxy "$CLAUDE_PROXY_URL" \
      --arg profile "$profile_display" \
      --arg log_file "$log_display" \
      --arg last_incident "$last_incident" \
      --arg last_recovery "$last_recovery" \
      --argjson notifications "$([ "$NOTIFY_ENABLED" = "1" ] && printf true || printf false)" \
      --argjson active_sessions "$active_count" \
      --argjson active_watchdogs "$watchdog_count" \
      --argjson log_bytes "$log_bytes" \
      --arg lifecycle "$([ "$STRICT_LIFECYCLE" = "1" ] && printf strict || printf warn)" \
      --argjson sessions "$sessions_json" \
      '{
        version: $version,
        health: $health,
        mode: $mode,
        lifecycle: $lifecycle,
        notifications: $notifications,
        config_state: $config_state,
        proxy: $proxy,
        profile: $profile,
        active_sessions: $active_sessions,
        active_watchdogs: $active_watchdogs,
        log_file: $log_file,
        log_bytes: $log_bytes,
        last_incident: (if $last_incident == "" then null else $last_incident end),
        last_recovery: (if $last_recovery == "" then null else $last_recovery end),
        sessions: $sessions
      }'
    return 0
  fi

  printf 'Claude Guard Status\n'
  printf '  version: %s\n' "$VERSION"
  printf '  health: %s\n' "$health_label"
  printf '  mode: %s\n' "$mode_label"
  printf '  notifications: %s\n' "$notify_label"
  printf '  config: %s\n' "$VISIBILITY_CONFIG_STATE"
  printf '  profile: %s\n' "$profile_display"
  printf '  proxy: %s\n' "$CLAUDE_PROXY_URL"
  printf '  lifecycle: %s\n' "$([ "$STRICT_LIFECYCLE" = "1" ] && printf strict || printf warn)"
  printf '  active Claude sessions: %s\n' "$active_count"
  printf '  active watchdogs: %s\n' "$watchdog_count"
  if [ -f "$LAUNCH_BLOCK_FILE" ]; then
    printf '  launch block: %s\n' "$(awk -F= '/^reason=/ { print substr($0, 8); exit }' "$LAUNCH_BLOCK_FILE")"
  else
    printf '  launch block: none\n'
  fi
  printf '  log: %s (%s bytes including archive)\n' "$log_display" "$log_bytes"
  printf 'Sessions:\n'
  if [ -z "$rows" ]; then
    printf '  none\n'
  else
    while IFS=$'\t' read -r target_pid pgid watchdog state timestamp; do
      [ -n "$target_pid" ] || continue
      if [ "$watchdog" = "1" ]; then
        watchdog="yes"
      else
        watchdog="no"
      fi
      printf '  pid=%s pgid=%s watchdog=%s state=%s last=%s\n' \
        "$target_pid" "$pgid" "$watchdog" "$state" "$timestamp"
    done <<EOF
$rows
EOF
  fi
  printf 'History:\n'
  printf '  last incident: %s\n' "${last_incident:-none}"
  printf '  last recovery: %s\n' "${last_recovery:-none}"
}

visibility_redact_stream() {
  awk -v home="$HOME" '
    function replace_literal(value, needle, replacement, result, position) {
      if (needle == "") return value
      result = ""
      while ((position = index(value, needle)) > 0) {
        result = result substr(value, 1, position - 1) replacement
        value = substr(value, position + length(needle))
      }
      return result value
    }
    {
      line = replace_literal($0, home, "~")
      gsub(/[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?/, "x.x.x.x", line)
      gsub(/[Tt][Oo][Kk][Ee][Nn]=[^ ]+/, "token=[REDACTED]", line)
      gsub(/[Ss][Ee][Cc][Rr][Ee][Tt]=[^ ]+/, "secret=[REDACTED]", line)
      gsub(/[Aa][Uu][Tt][Hh]=[^ ]+/, "auth=[REDACTED]", line)
      gsub(/[Kk][Ee][Yy]=[^ ]+/, "key=[REDACTED]", line)
      gsub(/path=\/[^ ]+/, "path=[REDACTED]", line)
      gsub(/profile=\/[^ ]+/, "profile=[REDACTED]", line)
      gsub(/command=\/[^ ]+/, "command=[REDACTED]", line)
      print line
    }
  '
}

print_diagnostic_report() {
  local rows active_count watchdog_count allowed_count mode_label

  load_visibility_config
  rows="$(visibility_session_rows)"
  active_count="$(printf '%s\n' "$rows" | awk 'NF { count += 1 } END { print count + 0 }')"
  watchdog_count="$(printf '%s\n' "$rows" | awk -F '\t' 'NF { count += $3 } END { print count + 0 }')"
  allowed_count=0
  if [ "$VISIBILITY_CONFIG_STATE" = "valid" ]; then
    allowed_count="$(jq -r '[(.allowed_ips // [])[], (.allowed_cidrs // [])[]] | length' "$CONFIG_FILE")"
  fi
  mode_label="action-refused"
  [ "$WATCHDOG_DRY_RUN" = "1" ] && mode_label="dry-run"

  {
    printf 'Claude Guard Diagnostic (redacted)\n'
    printf 'generated_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'version=%s\n' "$VERSION"
    printf 'platform=%s\n' "$(uname -srm 2>/dev/null || printf unknown)"
    printf 'mode=%s\n' "$mode_label"
    printf 'notifications=%s\n' "$NOTIFY_ENABLED"
    printf 'config_state=%s\n' "$VISIBILITY_CONFIG_STATE"
    printf 'profile=%s\n' "$VISIBILITY_PROFILE"
    printf 'proxy=%s\n' "$CLAUDE_PROXY_URL"
    printf 'allowed_entries=%s\n' "$allowed_count"
    printf 'active_sessions=%s\n' "$active_count"
    printf 'active_watchdogs=%s\n' "$watchdog_count"
    printf 'log_file=%s\n' "${LOG_FILE##*/}"
    printf 'log_bytes=%s\n' "$(visibility_log_bytes)"
    printf 'event_counts:\n'
    visibility_log_stream | awk '
      /watchdog started/ { started += 1 }
      /exit ip unavailable|exit ip unknown/ { unavailable += 1 }
      /exit ip not allowed/ { not_allowed += 1 }
      /api path unhealthy/ { api += 1 }
      /would pause Claude/ { paused += 1 }
      /would resume Claude/ { resumed += 1 }
      /watchdog exited|watchdog exiting because Claude/ { exited += 1 }
      END {
        printf "  watchdog_started=%d\n", started
        printf "  ip_unavailable=%d\n", unavailable
        printf "  ip_not_allowed=%d\n", not_allowed
        printf "  api_unhealthy=%d\n", api
        printf "  would_pause=%d\n", paused
        printf "  would_resume=%d\n", resumed
        printf "  watchdog_exited=%d\n", exited
      }
    '
    printf 'recent_events:\n'
    visibility_log_stream | awk '
      /watchdog|DRY RUN|api path unhealthy|exit ip|wake gap|route healthy|resume candidate/ { print }
    ' | tail -n 20
  } | visibility_redact_stream
}

current_timezone() {
  node -e 'console.log(Intl.DateTimeFormat().resolvedOptions().timeZone || "")' 2>/dev/null || true
}

redact_value() {
  local value="$1"

  if [ "${#value}" -le 12 ]; then
    printf '%s\n' "$value"
  else
    printf '%s...\n' "${value:0:8}"
  fi
}

client_scan_files() {
  local file="$1"
  local dir package_root="" scope_dir

  file="$(resolve_path "$file")"
  printf '%s\n' "$file"

  dir="$file"
  while [ "$dir" != "/" ] && [ -n "$dir" ]; do
    if [ "$(basename "$dir")" = "claude-code" ] && [ "$(basename "$(dirname "$dir")")" = "@anthropic-ai" ]; then
      package_root="$dir"
      break
    fi
    dir="$(dirname "$dir")"
  done

  if [ -n "$package_root" ]; then
    scope_dir="$(dirname "$package_root")"
    find "$scope_dir" -maxdepth 3 -type f \( -name 'claude' -o -name 'claude.exe' -o -name 'cli.js' -o -name 'cli-wrapper.cjs' \) 2>/dev/null
  fi
}

find_client_fingerprint_marker() {
  local file="$1"
  local scan_file seen=":"

  while IFS= read -r scan_file; do
    [ -n "$scan_file" ] || continue
    case "$seen" in
      *:"$scan_file":*) continue ;;
    esac
    seen="${seen}${scan_file}:"
    [ -r "$scan_file" ] || continue
    if LC_ALL=C grep -aEq 'Asia/Shanghai|Asia/Urumqi' "$scan_file" &&
      LC_ALL=C grep -aEq '\\u02BC|\\u02B9|Today.*date is|date is.*replaceAll|date is.*replace\(' "$scan_file"; then
      printf '%s\n' "$scan_file"
      return 0
    fi
  done <<EOF
$(client_scan_files "$file")
EOF

  return 1
}

check_legacy_profile_contamination() {
  local profile="$HOME/.claude/settings.json"
  local marker_re='ANTHROPIC_BASE_URL|ANTHROPIC_AUTH_TOKEN|ANTHROPIC_API_KEY|apiKeyHelper|127\.0\.0\.1:15721|PROXY_MANAGED|CLAUDE_CODE_USE_GATEWAY'
  local markers

  [ "$LEGACY_PROFILE_MODE" = "off" ] && return 0
  [ -f "$profile" ] || return 0
  if ! grep -Eiq "$marker_re" "$profile"; then
    return 0
  fi

  if [ "$LEGACY_PROFILE_MODE" = "strict" ]; then
    printf '旧默认 Claude profile 含有反代/凭据注入残留，strict 模式已拒绝启动: %s\n' "$profile" >&2
    markers="$(grep -Eio "$marker_re" "$profile" | sort -u || true)"
    printf '%s\n' "$markers" | sed 's/^/  - /' >&2
    exit 11
  fi

  ui_warn '旧默认 Claude profile 命中反代/凭据注入残留，但官方入口使用 CLAUDE_CONFIG_DIR=%s，按 warn 模式继续。' "$OFFICIAL_CONFIG_DIR"
  log_guard "WARN" "legacy profile contains proxy/auth markers path=${profile}; official profile remains isolated"
}

check_client_fingerprint_tripwire() {
  local claude_bin="$1"
  local resolved_bin tz active_reasons marker_found=0 current_base_url marker_file

  case "$FINGERPRINT_MODE" in
    off|warn|fail-active|strict) ;;
    *)
      printf 'CLAUDE_GUARD_FINGERPRINT_MODE 只能是 off、warn、fail-active 或 strict，当前是: %s\n' "$FINGERPRINT_MODE" >&2
      exit 10
      ;;
  esac

  [ "$FINGERPRINT_MODE" = "off" ] && return 0

  resolved_bin="$(resolve_path "$claude_bin")"
  marker_file="$(find_client_fingerprint_marker "$resolved_bin" || true)"
  if [ -n "$marker_file" ]; then
    marker_found=1
  fi

  if [ "$marker_found" -ne 1 ]; then
    ui_note '客户端指纹预检通过：未发现已知 date/time watermark 逻辑。'
    return 0
  fi

  tz="$(current_timezone)"
  current_base_url="${ANTHROPIC_BASE_URL:-}"
  active_reasons=""

  if [ -n "$current_base_url" ]; then
    active_reasons="${active_reasons} ANTHROPIC_BASE_URL=$(redact_value "$current_base_url")"
  fi
  case "$tz" in
    Asia/Shanghai|Asia/Urumqi)
      active_reasons="${active_reasons} timezone=${tz}"
      ;;
  esac

  if [ "$FINGERPRINT_MODE" = "strict" ]; then
    printf '客户端指纹预检失败：%s 含有已知 date/time watermark 逻辑，strict 模式拒绝启动。\n' "$marker_file" >&2
    exit 10
  fi

  if [ -n "$active_reasons" ]; then
    if [ "$FINGERPRINT_MODE" = "fail-active" ]; then
      printf '客户端指纹预检失败：%s 含有已知 date/time watermark 逻辑，且存在激活条件:%s\n' "$marker_file" "$active_reasons" >&2
      printf '请清理 ANTHROPIC_BASE_URL 或改用干净 timezone/profile 后再启动官方 Claude。\n' >&2
      exit 10
    fi
    ui_warn '客户端指纹预检警告：%s 含有已知 date/time watermark 逻辑，且存在激活条件:%s' "$marker_file" "$active_reasons"
    log_guard "WARN" "watermark-capable client with active conditions:${active_reasons}"
    return 0
  fi

  ui_warn '客户端指纹预检警告：%s 含有已知 date/time watermark 逻辑，但当前官方环境未发现激活条件，继续。' "$marker_file"
  log_guard "WARN" "watermark-capable client detected without active conditions path=${marker_file}"
}

is_ipv4() {
  local ip="$1"
  local a b c d

  IFS=. read -r a b c d <<EOF
$ip
EOF
  for part in "$a" "$b" "$c" "$d"; do
    case "$part" in
      ''|*[!0-9]*) return 1 ;;
    esac
    if [ "$part" -lt 0 ] || [ "$part" -gt 255 ]; then
      return 1
    fi
  done
  [ -n "$d" ] || return 1
  return 0
}

ipv4_to_int() {
  local ip="$1"
  local a b c d

  IFS=. read -r a b c d <<EOF
$ip
EOF
  printf '%u\n' "$(( (a << 24) + (b << 16) + (c << 8) + d ))"
}

cidr_contains_ip() {
  local ip="$1"
  local cidr="$2"
  local base prefix ip_num base_num mask

  base="${cidr%/*}"
  prefix="${cidr#*/}"
  is_ipv4 "$ip" || return 1
  is_ipv4 "$base" || return 1
  case "$prefix" in
    ''|*[!0-9]*) return 1 ;;
  esac
  if [ "$prefix" -lt 0 ] || [ "$prefix" -gt 32 ]; then
    return 1
  fi

  ip_num="$(ipv4_to_int "$ip")"
  base_num="$(ipv4_to_int "$base")"
  if [ "$prefix" -eq 0 ]; then
    mask=0
  else
    mask="$(( (0xffffffff << (32 - prefix)) & 0xffffffff ))"
  fi
  [ "$((ip_num & mask))" -eq "$((base_num & mask))" ]
}

get_current_ip_once() {
  local url ip raw

  for url in $IP_CHECK_URLS; do
    # curl 非零退出时一律丢弃响应体。--max-time 超时（退出码 28）等情况下 curl 可能
    # 已经吐出包含完整 ip= 字段的部分响应，采信它等于拿一个来路不明的截断结果去判定
    # 白名单；此处宁可探测失败，交给外层重试与 exit 3 处理。
    if ! raw="$(official_net_env curl -q -4 -x "$CLAUDE_PROXY_URL" --cacert "$CA_CERT_FILE" -fsS --connect-timeout 5 --max-time 10 "$url" 2>/dev/null)"; then
      continue
    fi

    # 裸 IP 响应体，例如 https://api.ipify.org。
    ip="$(printf '%s' "$raw" | tr -d '[:space:]')"
    if is_ipv4 "$ip"; then
      CURRENT_IP_SOURCE="$url"
      printf '%s\n' "$ip"
      return 0
    fi

    # Cloudflare /cdn-cgi/trace 响应体：形如 ip=203.0.113.10 的 key=value 多行文本。
    ip="$(printf '%s\n' "$raw" | awk -F= '/^ip=/ { print $2; exit }' | tr -d '[:space:]')"
    if is_ipv4 "$ip"; then
      CURRENT_IP_SOURCE="$url"
      printf '%s\n' "$ip"
      return 0
    fi
  done
  return 1
}

is_allowed_ip() {
  local ip="$1"
  local cidr

  if jq -e --arg ip "$ip" '.allowed_ips // [] | index($ip)' "$CONFIG_FILE" >/dev/null; then
    return 0
  fi

  while IFS= read -r cidr; do
    [ -n "$cidr" ] || continue
    if cidr_contains_ip "$ip" "$cidr"; then
      return 0
    fi
  done <<EOF
$(jq -r '[(.allowed_ips // [])[], (.allowed_cidrs // [])[]] | .[] | select(type == "string" and contains("/"))' "$CONFIG_FILE")
EOF

  return 1
}

check_api_path_once() {
  tls_probe_once api.anthropic.com
}

watchdog_log() {
  local target_pid="$1"
  local level="$2"
  local message="$3"

  log_guard "$level" "watchdog pid=${target_pid} ${message}"
}

watchdog_signal_exit() {
  local target_pid="$1"
  local signal="$2"

  trap - HUP INT TERM
  watchdog_log "$target_pid" "INFO" "watchdog exited reason=signal-${signal}"
  exit 0
}

write_launch_block() {
  local reason="$1"
  local action="$2"
  local dir

  dir="$(dirname "$LAUNCH_BLOCK_FILE")"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf 'reason=%s\naction=%s\n' "$reason" "$action" >"$LAUNCH_BLOCK_FILE" 2>/dev/null || true
}

clear_launch_block() {
  rm -f "$LAUNCH_BLOCK_FILE" 2>/dev/null || true
}

signal_target_tree() {
  local root="$1"
  local sig="$2"
  local self snapshot pids pid

  case "$root" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$root" -gt 1 ] || return 1
  # $$ 在后台子 shell 里仍是父进程。看门狗自己的 PID 要用 BASHPID，
  # bash 3.2 没有 BASHPID，退回到子 sh 的 PPID。
  if [ -n "${BASHPID:-}" ] && [ "$BASHPID" != "$$" ]; then
    self="$BASHPID"
  else
    self="$(sh -c 'echo "$PPID"')"
  fi
  snapshot="$(ps -axo pid=,ppid= 2>/dev/null || true)"
  pids="$(printf '%s\n' "$snapshot" | awk -v root="$root" -v self="$self" '
    NF >= 2 {
      pid = $1
      ppid = $2
      parent[pid] = ppid
      pids[++n] = pid
    }
    END {
      for (i = 1; i <= n; i++) {
        p = pids[i]
        if (p == self || p == root || p == 1) continue
        cur = p
        for (hop = 0; hop < 30; hop++) {
          if (cur == root) { print p; break }
          if (cur == "" || cur == 0 || cur == 1) break
          cur = parent[cur]
        }
      }
    }
  ')"
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    kill "-${sig}" "$pid" 2>/dev/null || true
  done <<EOF
$pids
EOF
  if [ "$root" != "$self" ]; then
    kill "-${sig}" "$root" 2>/dev/null || true
  fi
}

pause_target() {
  local target_pid="$1"
  local reason="$2"

  write_launch_block "$reason" "block-new-launches"
  if [ "$WATCHDOG_STRICT" = "1" ]; then
    log_guard "ERROR" "strict action: signal=${WATCHDOG_STRICT_SIGNAL} pid=${target_pid}; reason=${reason}; existing session targeted"
    notify_guard "Strict: ${WATCHDOG_STRICT_SIGNAL} Claude pid ${target_pid} because ${reason}"
    signal_target_tree "$target_pid" "$WATCHDOG_STRICT_SIGNAL"
    return 0
  fi

  if [ "$WATCHDOG_DRY_RUN" = "1" ]; then
    log_guard "WARN" "DRY RUN: would pause Claude pid=${target_pid}; reason=${reason}"
    log_guard "WARN" "existing session left running pid=${target_pid}; new launches blocked by egress precheck"
    if [ "$DRY_RUN_STDERR" = "1" ]; then
      printf '\nClaude Guardian dry-run: would pause Claude because %s\n' "$reason" >&2
    fi
    notify_guard "Dry-run: would pause Claude pid ${target_pid} because ${reason}"
    return 0
  fi

  printf 'Claude Guardian 不会在未设置 CLAUDE_GUARD_WATCHDOG_STRICT=1 时暂停或结束已有会话。\n' >&2
  log_guard "ERROR" "action mode refused; existing session left running pid=${target_pid}; reason=${reason}"
  return 1
}

resume_target() {
  local target_pid="$1"
  local reason="$2"

  clear_launch_block
  if [ "$WATCHDOG_STRICT" = "1" ]; then
    if [ "$WATCHDOG_STRICT_SIGNAL" = "STOP" ]; then
      log_guard "INFO" "strict action: signal=CONT pid=${target_pid}; reason=${reason}"
      signal_target_tree "$target_pid" "CONT"
    else
      log_guard "INFO" "strict action: process was signaled TERM pid=${target_pid}; resume requires a new launch; reason=${reason}"
    fi
    notify_guard "Strict: would resume Claude pid ${target_pid} because ${reason}"
    return 0
  fi

  if [ "$WATCHDOG_DRY_RUN" = "1" ]; then
    log_guard "INFO" "DRY RUN: would resume Claude pid=${target_pid}; reason=${reason}"
    if [ "$DRY_RUN_STDERR" = "1" ]; then
      printf '\nClaude Guardian dry-run: would resume Claude because %s\n' "$reason" >&2
    fi
    notify_guard "Dry-run: would resume Claude pid ${target_pid} because ${reason}"
    return 0
  fi

  printf 'Claude Guardian action mode is disabled in v%s; cannot resume pid=%s safely.\n' "$VERSION" "$target_pid" >&2
  log_guard "ERROR" "action mode refused; unsafe to resume only pid=${target_pid}; reason=${reason}"
  return 1
}

run_watchdog() {
  local target_pid="$1"
  local state="healthy"
  local current_ip=""
  local ip_status="unavailable"
  local ip_ok=0
  local api_ok=1
  local ip_bad_count=0
  local api_bad_count=0
  local resume_good_count=0
  local recovery_failure_count=0
  local paused_since=0
  local kill_notice_logged=0
  local last_tick now next_ip_check next_api_check next_recovery_check reason previous_count

  last_tick="$(date +%s)"
  next_ip_check="$last_tick"
  next_api_check="$last_tick"
  next_recovery_check="$last_tick"
  log_guard "INFO" "watchdog started pid=${target_pid} proxy=${CLAUDE_PROXY_URL} dry_run=${WATCHDOG_DRY_RUN}"
  trap 'watchdog_signal_exit "$target_pid" HUP' HUP
  trap 'watchdog_signal_exit "$target_pid" INT' INT
  trap 'watchdog_signal_exit "$target_pid" TERM' TERM

  while kill -0 "$target_pid" 2>/dev/null; do
    now="$(date +%s)"

    if [ $((now - last_tick)) -gt "$WAKE_GAP_SECONDS" ]; then
      watchdog_log "$target_pid" "WARN" "wake gap detected gap_seconds=$((now - last_tick)) state=${state}"
      resume_good_count=0
      if [ "$state" = "paused" ] || [ "$state" = "resume-pending" ]; then
        state="paused"
        next_recovery_check="$now"
      else
        state="degraded"
        next_ip_check="$now"
        next_api_check="$now"
      fi
    fi
    last_tick="$now"

    if [ "$state" = "paused" ] || [ "$state" = "resume-pending" ]; then
      if [ "$now" -ge "$next_recovery_check" ]; then
        current_ip="$(get_current_ip_once || true)"
        if [ -z "$current_ip" ]; then
          ip_status="unavailable"
          ip_ok=0
        elif is_allowed_ip "$current_ip"; then
          ip_status="allowed"
          ip_ok=1
        else
          ip_status="not-allowed"
          ip_ok=0
        fi

        if check_api_path_once; then
          api_ok=1
        else
          api_ok=0
        fi

        if [ "$ip_ok" -eq 1 ] && [ "$api_ok" -eq 1 ]; then
          state="resume-pending"
          recovery_failure_count=0
          resume_good_count=$((resume_good_count + 1))
          watchdog_log "$target_pid" "INFO" "resume candidate count=${resume_good_count}/${RESUME_GOOD_THRESHOLD} ip=${current_ip}"
          if [ "$resume_good_count" -ge "$RESUME_GOOD_THRESHOLD" ]; then
            reason="route healthy again ip=${current_ip}"
            resume_target "$target_pid" "$reason" || true
            state="healthy"
            ip_bad_count=0
            api_bad_count=0
            resume_good_count=0
            paused_since=0
            kill_notice_logged=0
            next_ip_check=$((now + IP_INTERVAL))
            next_api_check=$((now + API_INTERVAL))
          fi
        else
          state="paused"
          resume_good_count=0
          recovery_failure_count=$((recovery_failure_count + 1))
          if [ "$recovery_failure_count" -eq 1 ] || [ $((recovery_failure_count % 10)) -eq 0 ]; then
            watchdog_log "$target_pid" "WARN" \
              "recovery check unhealthy attempt=${recovery_failure_count} ip_status=${ip_status} api_ok=${api_ok}"
          fi
        fi
        next_recovery_check=$(($(date +%s) + RECOVERY_INTERVAL))
      fi

      if [ -n "$KILL_AFTER_PAUSE_SECONDS" ] && [ "$paused_since" -gt 0 ] && \
         [ $((now - paused_since)) -ge "$KILL_AFTER_PAUSE_SECONDS" ] && \
         [ "$kill_notice_logged" -eq 0 ]; then
        if [ "$WATCHDOG_STRICT" = "1" ] && [ "$WATCHDOG_STRICT_SIGNAL" = "STOP" ]; then
          watchdog_log "$target_pid" "ERROR" \
            "strict action: signal=TERM pid=${target_pid}; kill-after-pause reached"
          signal_target_tree "$target_pid" "TERM"
        else
          watchdog_log "$target_pid" "ERROR" \
            "kill-after-pause reached; observe mode does not signal existing sessions pid=${target_pid}"
        fi
        kill_notice_logged=1
      fi

      sleep "$WATCHDOG_TICK_SECONDS"
      continue
    fi

    if [ "$now" -ge "$next_ip_check" ]; then
      current_ip="$(get_current_ip_once || true)"
      if [ -z "$current_ip" ]; then
        ip_status="unavailable"
        ip_ok=0
        previous_count="$ip_bad_count"
        if [ "$ip_bad_count" -lt "$IP_BAD_THRESHOLD" ]; then
          ip_bad_count=$((ip_bad_count + 1))
        fi
        if [ "$ip_bad_count" -ne "$previous_count" ]; then
          watchdog_log "$target_pid" "WARN" \
            "exit ip unavailable count=${ip_bad_count}/${IP_BAD_THRESHOLD} state=${state}"
        fi
      elif is_allowed_ip "$current_ip"; then
        ip_status="allowed"
        ip_ok=1
        ip_bad_count=0
      else
        ip_status="not-allowed"
        ip_ok=0
        previous_count="$ip_bad_count"
        if [ "$ip_bad_count" -lt "$IP_BAD_THRESHOLD" ]; then
          ip_bad_count=$((ip_bad_count + 1))
        fi
        if [ "$ip_bad_count" -ne "$previous_count" ]; then
          watchdog_log "$target_pid" "WARN" \
            "exit ip not allowed ip=${current_ip} count=${ip_bad_count}/${IP_BAD_THRESHOLD} state=${state}"
        fi
      fi
      next_ip_check=$((now + IP_INTERVAL))
    fi

    if [ "$now" -ge "$next_api_check" ]; then
      if check_api_path_once; then
        api_ok=1
        api_bad_count=0
      else
        api_ok=0
        previous_count="$api_bad_count"
        if [ "$api_bad_count" -lt "$API_BAD_THRESHOLD" ]; then
          api_bad_count=$((api_bad_count + 1))
        fi
        if [ "$api_bad_count" -ne "$previous_count" ]; then
          watchdog_log "$target_pid" "WARN" \
            "api path unhealthy count=${api_bad_count}/${API_BAD_THRESHOLD} state=${state}"
        fi
      fi
      next_api_check=$((now + API_INTERVAL))
    fi

    if [ "$ip_bad_count" -ge "$IP_BAD_THRESHOLD" ]; then
      state="paused"
      paused_since="$now"
      if [ "$ip_status" = "unavailable" ]; then
        reason="exit IP check unavailable"
      else
        reason="exit IP not allowed ip=${current_ip}"
      fi
      pause_target "$target_pid" "$reason" || true
      next_recovery_check=$(($(date +%s) + RECOVERY_INTERVAL))
    elif [ "$api_bad_count" -ge "$API_BAD_THRESHOLD" ]; then
      state="paused"
      paused_since="$now"
      reason="api path unhealthy"
      pause_target "$target_pid" "$reason" || true
      next_recovery_check=$(($(date +%s) + RECOVERY_INTERVAL))
    elif [ "$ip_ok" -eq 1 ] && [ "$api_ok" -eq 1 ]; then
      if [ "$state" != "healthy" ]; then
        watchdog_log "$target_pid" "INFO" "route healthy ip=${current_ip:-unknown}"
      fi
      state="healthy"
    else
      state="degraded"
    fi

    sleep "$WATCHDOG_TICK_SECONDS"
  done

  trap - HUP INT TERM
  watchdog_log "$target_pid" "INFO" "watchdog exited reason=target-gone"
}

start_watchdog_sidecar() {
  if [ "$WATCHDOG_ENABLED" != "1" ]; then
    return 0
  fi

  resolve_watchdog_strict
  if [ "$WATCHDOG_STRICT" != "1" ] && [ "$WATCHDOG_DRY_RUN" != "1" ]; then
    printf 'Claude Guardian action mode is not enabled in v%s. Existing sessions stay running unless CLAUDE_GUARD_WATCHDOG_STRICT=1.\n' "$VERSION" >&2
    printf 'Please use CLAUDE_GUARD_WATCHDOG_DRY_RUN=1, or set CLAUDE_GUARD_WATCHDOG_STRICT=1 to signal the watched process tree.\n' >&2
    exit 9
  fi

  run_watchdog "$$" &
}

exec_claude() {
  # exec 只能替换成外部命令，不能调用函数。数组始终非空，避免 bash 3.2
  # 在 set -u 下展开空数组。
  local -a env_args
  env_args=(
    "HOME=${HOME}"
    "USER=${USER:-user}"
    "PATH=${PATH}"
    "TERM=${TERM:-xterm-256color}"
    "LANG=${LANG:-en_US.UTF-8}"
    "LC_ALL=${LC_ALL:-en_US.UTF-8}"
    "SHELL=${SHELL:-/bin/zsh}"
    "HTTP_PROXY=${CLAUDE_PROXY_URL}"
    "HTTPS_PROXY=${CLAUDE_PROXY_URL}"
    "ALL_PROXY=${CLAUDE_PROXY_URL}"
    "http_proxy=${CLAUDE_PROXY_URL}"
    "https_proxy=${CLAUDE_PROXY_URL}"
    "all_proxy=${CLAUDE_PROXY_URL}"
    "NO_PROXY=${NO_PROXY_LIST}"
    "no_proxy=${NO_PROXY_LIST}"
    "CLAUDE_CONFIG_DIR=${OFFICIAL_CONFIG_DIR}"
    "DISABLE_AUTOUPDATER=1"
    "DISABLE_ERROR_REPORTING=1"
    "DISABLE_FEEDBACK_COMMAND=1"
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1"
    "DISABLE_UPDATES=1"
    "CLAUDE_CODE_CERT_STORE=system"
    "SSL_CERT_FILE=${CA_CERT_FILE}"
    "NODE_EXTRA_CA_CERTS=${CA_CERT_FILE}"
  )
  if [ "$STRICT_LIFECYCLE" = "1" ]; then
    env_args+=(
      "CLAUDE_CODE_DISABLE_AGENT_VIEW=1"
      "CLAUDE_CODE_DISABLE_CRON=1"
      "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF=1"
      "CLAUDE_DISABLE_ADOPT=1"
      "CLAUDE_CODE_DISABLE_WORKFLOWS=1"
      "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS=0"
      "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=1"
      "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=3"
    )
  fi
  if [ -f "$OFFICIAL_SETTINGS" ]; then
    exec env -i "${env_args[@]}" \
      "$CLAUDE_BIN" \
      --setting-sources=user,project \
      --settings "$OFFICIAL_SETTINGS" \
      "$@"
  fi
  exec env -i "${env_args[@]}" \
    "$CLAUDE_BIN" \
    "$@"
}

resolve_mihomo_strict() {
  local configured="0"

  if [ "${CLAUDE_GUARD_MIHOMO_STRICT+x}" = "x" ]; then
    configured="$CLAUDE_GUARD_MIHOMO_STRICT"
  elif [ -f "$CONFIG_FILE" ] && jq -e '.mihomo.strict != null and (.mihomo.strict | type) != "boolean"' "$CONFIG_FILE" >/dev/null 2>&1; then
    printf '配置中的 mihomo.strict 必须是 true 或 false。\n' >&2
    exit 2
  elif [ -f "$CONFIG_FILE" ] && jq -e '.mihomo.strict == true' "$CONFIG_FILE" >/dev/null 2>&1; then
    configured="1"
  fi

  case "$configured" in
    1|true|TRUE|yes|YES) MIHOMO_STRICT=1 ;;
    0|false|FALSE|no|NO|"") MIHOMO_STRICT=0 ;;
    *)
      printf 'CLAUDE_GUARD_MIHOMO_STRICT 只能是 0 或 1，当前是: %s\n' "$configured" >&2
      exit 2
      ;;
  esac
}

mihomo_mark_finding() {
  MIHOMO_FINDINGS=1
  if [ "$MIHOMO_STRICT" = "1" ]; then
    DOCTOR_BLOCK=1
  fi
}

mihomo_get() {
  local path="$1"
  local dest="$2"

  if [ "$MIHOMO_KIND" = "unix" ]; then
    curl -q -X GET --noproxy '*' --unix-socket "$MIHOMO_SOCKET" \
      -fsS --connect-timeout 2 --max-time 5 \
      -o "$dest" \
      "http://localhost${path}"
    return $?
  fi
  if [ -n "$MIHOMO_SECRET" ]; then
    curl -q -X GET --noproxy '*' \
      -fsS --connect-timeout 2 --max-time 5 \
      -H "Authorization: Bearer ${MIHOMO_SECRET}" \
      -o "$dest" \
      "${MIHOMO_HTTP_BASE}${path}"
    return $?
  fi
  curl -q -X GET --noproxy '*' \
    -fsS --connect-timeout 2 --max-time 5 \
    -o "$dest" \
    "${MIHOMO_HTTP_BASE}${path}"
}

match_domain_proxy() {
  local domain="$1"
  local rules_file="$2"
  local type payload proxy

  while IFS=$'\037' read -r type payload proxy; do
    [ -n "$type" ] || continue
    case "$type" in
      Domain|DOMAIN)
        if [ "$payload" = "$domain" ]; then
          printf '%s\n' "$proxy"
          return 0
        fi
        ;;
      DomainSuffix|DOMAIN-SUFFIX)
        if [ "$domain" = "$payload" ]; then
          printf '%s\n' "$proxy"
          return 0
        fi
        case "$domain" in
          *."$payload")
            printf '%s\n' "$proxy"
            return 0
            ;;
        esac
        ;;
      DomainKeyword|DOMAIN-KEYWORD)
        case "$domain" in
          *"$payload"*)
            printf '%s\n' "$proxy"
            return 0
            ;;
        esac
        ;;
      Match|MATCH)
        printf '%s\n' "$proxy"
        return 0
        ;;
    esac
  done <"$rules_file"
  printf 'UNCOVERED\n'
}

report_mihomo() {
  local api sock report_dir rules_file proxies_file configs_file conn_file allow_file
  local expect_group covered total proxy domain member typ now all_csv
  local groups_file group direct_members extra_members selected

  resolve_mihomo_strict
  MIHOMO_FINDINGS=0
  MIHOMO_KIND=""
  MIHOMO_SOCKET=""
  MIHOMO_HTTP_BASE=""
  MIHOMO_SECRET="${CLAUDE_GUARD_MIHOMO_SECRET:-}"
  MIHOMO_SELECTED_NODE=""
  api=""
  expect_group=""
  if [ -z "$MIHOMO_SECRET" ] && [ -f "$CONFIG_FILE" ]; then
    MIHOMO_SECRET="$(jq -r '.mihomo.secret // empty' "$CONFIG_FILE" 2>/dev/null || true)"
  fi
  if [ "${CLAUDE_GUARD_MIHOMO_API+x}" = "x" ]; then
    api="$CLAUDE_GUARD_MIHOMO_API"
  elif [ -f "$CONFIG_FILE" ]; then
    api="$(jq -r '.mihomo.api // empty' "$CONFIG_FILE" 2>/dev/null || true)"
  fi
  if [ -f "$CONFIG_FILE" ]; then
    expect_group="$(jq -r '.mihomo.group // empty' "$CONFIG_FILE" 2>/dev/null || true)"
  fi
  if [ -z "$api" ]; then
    sock="/var/run/clash-verge-service/users/$(id -u)/verge-mihomo.sock"
    if [ -S "$sock" ]; then
      api="unix://${sock}"
    fi
  fi

  printf 'Mihomo（只读）:\n'
  if [ -z "$api" ]; then
    printf '  控制器: 未配置，且未发现 verge-mihomo.sock\n'
    printf '  说明: 跳过只读查询。本工具不会修改 Clash 配置或订阅。\n'
    return 0
  fi
  case "$api" in
    unix://*)
      MIHOMO_KIND="unix"
      MIHOMO_SOCKET="${api#unix://}"
      ;;
    http://*|https://*)
      MIHOMO_KIND="http"
      MIHOMO_HTTP_BASE="${api%/}"
      ;;
    *)
      printf '  控制器: 无法识别\n'
      printf '  警告: mihomo.api 必须以 unix://、http:// 或 https:// 开头。\n'
      mihomo_mark_finding
      return 0
      ;;
  esac
  printf '  控制器: %s\n' "$api"

  report_dir="$(mktemp -d "${TMPDIR:-/tmp}/claude-guard-mihomo.XXXXXX")"
  rules_file="${report_dir}/rules.tsv"
  proxies_file="${report_dir}/proxies.json"
  configs_file="${report_dir}/configs.json"
  conn_file="${report_dir}/connections.json"
  allow_file="${report_dir}/allowed-nodes"
  groups_file="${report_dir}/groups"
  : >"$groups_file"
  if [ -f "$CONFIG_FILE" ]; then
    jq -r '.mihomo.allowed_nodes // [] | .[]' "$CONFIG_FILE" >"$allow_file" 2>/dev/null || : >"$allow_file"
  else
    : >"$allow_file"
  fi

  if ! mihomo_get /configs "$configs_file" >/dev/null 2>&1; then
    printf '  可达: no\n'
    printf '  说明: 控制器查询失败。未修改 Clash 配置或订阅。\n'
    rm -rf "$report_dir"
    return 0
  fi
  printf '  可达: yes\n'
  mihomo_get /proxies "$proxies_file" >/dev/null 2>&1 || printf '{}\n' >"$proxies_file"
  mihomo_get /rules "$report_dir/rules.json" >/dev/null 2>&1 || printf '{"rules":[]}\n' >"$report_dir/rules.json"
  mihomo_get /connections "$conn_file" >/dev/null 2>&1 || printf '{"connections":[]}\n' >"$conn_file"
  MIHOMO_CONN_JSON="$conn_file"

  jq -r '
    def tun: if (.tun | type) == "object" then .tun else {} end;
    [
      (if (tun | has("enable")) then tun.enable else false end | tostring),
      (if (tun | has("strict-route")) then tun["strict-route"]
        elif (tun | has("strict_route")) then tun.strict_route
        elif (tun | has("strictRoute")) then tun.strictRoute
        else "absent" end | tostring),
      (tun.stack // ""),
      (if (.dns | type) == "object" and (.dns | has("enhanced-mode")) then .dns["enhanced-mode"]
        elif (.dns | type) == "object" and (.dns | has("enhanced_mode")) then .dns.enhanced_mode
        else "absent" end | tostring),
      (if has("ipv6") then .ipv6 else "absent" end | tostring)
    ] | join("\u001f")
  ' "$configs_file" 2>/dev/null | {
    IFS=$'\037' read -r tun_enable strict_route tun_stack dns_mode ipv6_mode || true
    printf '  tun.enable: %s\n' "${tun_enable:-unknown}"
    printf '  tun.strict-route: %s\n' "${strict_route:-unknown}"
    printf '  tun.stack: %s\n' "${tun_stack:-}"
    printf '  dns.enhanced-mode: %s\n' "${dns_mode:-unknown}"
    printf '  ipv6: %s\n' "${ipv6_mode:-unknown}"
    if [ "${tun_enable:-false}" != "true" ]; then
      printf '  警告: TUN 未开启。\n'
      mihomo_mark_finding
    fi
    if [ "${strict_route:-false}" != "true" ]; then
      printf '  警告: tun.strict-route 未开启，开机或重启时流量可能绕过 TUN。\n'
      mihomo_mark_finding
    fi
  } || true

  # The pipeline above runs mihomo_mark_finding in a subshell. Re-read the printed
  # warnings is unreliable, so evaluate the same fields in the current shell.
  strict_route="$(jq -r '
    def tun: if (.tun | type) == "object" then .tun else {} end;
    if (tun | has("strict-route")) then tun["strict-route"]
    elif (tun | has("strict_route")) then tun.strict_route
    elif (tun | has("strictRoute")) then tun.strictRoute
    else "absent" end | tostring
  ' "$configs_file" 2>/dev/null || printf 'absent')"
  tun_enable="$(jq -r '(.tun.enable // false) | tostring' "$configs_file" 2>/dev/null || printf 'false')"
  if [ "$tun_enable" != "true" ]; then
    mihomo_mark_finding
  fi
  if [ "$strict_route" != "true" ]; then
    mihomo_mark_finding
  fi

  jq -r '
    (if type == "array" then . elif (.rules | type) == "array" then .rules else [] end)
    | .[]
    | [(.type // ""), (.payload // ""), (.proxy // .policy // "")]
    | join("\u001f")
  ' "$report_dir/rules.json" >"$rules_file" 2>/dev/null || : >"$rules_file"

  covered=0
  total=0
  while IFS= read -r domain; do
    [ -n "$domain" ] || continue
    total=$((total + 1))
    proxy="$(match_domain_proxy "$domain" "$rules_file")"
    case "$proxy" in
      UNCOVERED)
        printf '  未覆盖: %s\n' "$domain"
        mihomo_mark_finding
        ;;
      DIRECT|Direct|direct)
        printf '  命中 DIRECT: %s\n' "$domain"
        mihomo_mark_finding
        ;;
      *)
        if [ -n "$expect_group" ] && [ "$proxy" != "$expect_group" ]; then
          printf '  未命中期望组: %s -> %s（期望 %s）\n' "$domain" "$proxy" "$expect_group"
          mihomo_mark_finding
        else
          covered=$((covered + 1))
          printf '%s\n' "$proxy" >>"$groups_file"
        fi
        ;;
    esac
  done <<'EOF'
api.anthropic.com
claude.ai
claude.com
platform.claude.com
sso.claude.com
downloads.claude.ai
mcp-proxy.anthropic.com
assets-proxy.anthropic.com
bridge.claudeusercontent.com
cdn.claudemcpcontent.com
EOF
  printf '  已覆盖: %s/%s 个必需域名\n' "$covered" "$total"

  while IFS= read -r domain; do
    [ -n "$domain" ] || continue
    proxy="$(match_domain_proxy "$domain" "$rules_file")"
    case "$proxy" in
      UNCOVERED|DIRECT|Direct|direct)
        printf '  遥测未覆盖: %s\n' "$domain"
        ;;
      *)
        if [ -n "$expect_group" ] && [ "$proxy" != "$expect_group" ]; then
          printf '  遥测未覆盖: %s -> %s\n' "$domain" "$proxy"
        else
          printf '%s\n' "$proxy" >>"$groups_file"
        fi
        ;;
    esac
  done <<'EOF'
http-intake.logs.us5.datadoghq.com
browser-intake-us5-datadoghq.com
EOF

  if [ -n "$expect_group" ]; then
    printf '%s\n' "$expect_group" >>"$groups_file"
  fi
  sort -u "$groups_file" | while IFS= read -r group; do
    [ -n "$group" ] || continue
    if ! jq -e --arg name "$group" '.proxies[$name] != null' "$proxies_file" >/dev/null 2>&1; then
      continue
    fi
    now="$(jq -r --arg name "$group" '.proxies[$name].now // ""' "$proxies_file" 2>/dev/null || true)"
    typ="$(jq -r --arg name "$group" '.proxies[$name].type // ""' "$proxies_file" 2>/dev/null || true)"
    all_csv="$(jq -r --arg name "$group" '(.proxies[$name].all // []) | join(",")' "$proxies_file" 2>/dev/null || true)"
    case "$typ" in
      Selector|URLTest|Fallback|LoadBalance|Select|Relay) ;;
      *) continue ;;
    esac
    printf '  规则命中组: %s\n' "$group"
    printf '  组类型: %s\n' "$typ"
    printf '  选中节点: %s\n' "${now:-unknown}"
    printf '  组成员: %s\n' "${all_csv:-}"
    if [ -z "$MIHOMO_SELECTED_NODE" ] && [ -n "$now" ]; then
      MIHOMO_SELECTED_NODE="$now"
    fi
    direct_members=""
    extra_members=""
    IFS=','
    # shellcheck disable=SC2086 # comma-separated member list; IFS is comma here
    for member in $all_csv; do
      [ -n "$member" ] || continue
      case "$member" in
        REJECT|Reject|reject) continue ;;
      esac
      selected="$(jq -r --arg name "$member" '.proxies[$name].type // empty' "$proxies_file" 2>/dev/null || true)"
      case "$member" in
        DIRECT|Direct|direct)
          direct_members="${direct_members} ${member}"
          continue
          ;;
      esac
      case "$selected" in
        Direct|direct|DIRECT)
          direct_members="${direct_members} ${member}"
          continue
          ;;
      esac
      if [ -s "$allow_file" ]; then
        if ! grep -Fxq "$member" "$allow_file"; then
          extra_members="${extra_members} ${member}"
        fi
      fi
    done
    unset IFS
    if [ -n "$direct_members" ]; then
      printf '  警告: 组内包含 DIRECT:%s\n' "$direct_members"
      mihomo_mark_finding
    fi
    if [ -n "$now" ]; then
      case "$now" in
        DIRECT|Direct|direct)
          printf '  警告: 当前选中节点是 DIRECT。\n'
          mihomo_mark_finding
          ;;
      esac
      if [ -s "$allow_file" ] && ! grep -Fxq "$now" "$allow_file"; then
        printf '  警告: 选中节点不在 allowed_nodes 中: %s\n' "$now"
        mihomo_mark_finding
      fi
    fi
    if [ -n "$extra_members" ]; then
      printf '  警告: 组内包含未列入 allowed_nodes 的节点:%s\n' "$extra_members"
      mihomo_mark_finding
    elif [ ! -s "$allow_file" ]; then
      printf '  说明: 未配置 allowed_nodes，只检查 DIRECT。\n'
    fi
  done

  # sort|while is a pipeline, so finding flags set inside it are lost.
  # Re-scan groups in the current shell.
  while IFS= read -r group; do
    [ -n "$group" ] || continue
    jq -e --arg name "$group" '.proxies[$name].type as $t | ["Selector","URLTest","Fallback","LoadBalance","Select","Relay"] | index($t)' \
      "$proxies_file" >/dev/null 2>&1 || continue
    now="$(jq -r --arg name "$group" '.proxies[$name].now // ""' "$proxies_file" 2>/dev/null || true)"
    all_csv="$(jq -r --arg name "$group" '(.proxies[$name].all // []) | join(",")' "$proxies_file" 2>/dev/null || true)"
    if [ -z "$MIHOMO_SELECTED_NODE" ] && [ -n "$now" ]; then
      MIHOMO_SELECTED_NODE="$now"
    fi
    case "$now" in
      DIRECT|Direct|direct) mihomo_mark_finding ;;
    esac
    if [ -n "$now" ] && [ -s "$allow_file" ] && ! grep -Fxq "$now" "$allow_file"; then
      mihomo_mark_finding
    fi
    old_ifs="$IFS"
    IFS=','
    # shellcheck disable=SC2086 # comma-separated member list; IFS is comma here
    for member in $all_csv; do
      [ -n "$member" ] || continue
      case "$member" in
        REJECT|Reject|reject) continue ;;
        DIRECT|Direct|direct) mihomo_mark_finding; continue ;;
      esac
      selected="$(jq -r --arg name "$member" '.proxies[$name].type // empty' "$proxies_file" 2>/dev/null || true)"
      case "$selected" in
        Direct|direct|DIRECT) mihomo_mark_finding; continue ;;
      esac
      if [ -s "$allow_file" ] && ! grep -Fxq "$member" "$allow_file"; then
        mihomo_mark_finding
      fi
    done
    IFS="$old_ifs"
  done <<EOF
$(sort -u "$groups_file")
EOF

  if [ "$MIHOMO_FINDINGS" = "1" ]; then
    printf '  结论: 有告警。默认只警告；CLAUDE_GUARD_MIHOMO_STRICT=1 时 doctor 拒绝启动。\n'
  else
    printf '  结论: 未发现 DIRECT、必需域名缺口或 strict-route 关闭。\n'
  fi
  printf '  说明: 以上为只读查询，未修改 Clash 配置或订阅。\n'
  # Keep the connection snapshot for the desktop section, drop the rest.
  if [ -f "$conn_file" ]; then
    cp "$conn_file" "${report_dir}.connections.json"
    MIHOMO_CONN_JSON="${report_dir}.connections.json"
  fi
  rm -rf "$report_dir"
}

print_clash_snippet() {
  local node group

  node="${MIHOMO_SELECTED_NODE:-}"
  if [ -z "$node" ] || [ "$node" = "DIRECT" ] || [ "$node" = "REJECT" ]; then
    if [ -f "$CONFIG_FILE" ]; then
      node="$(jq -r '.mihomo.allowed_nodes[0] // empty' "$CONFIG_FILE" 2>/dev/null || true)"
    fi
  fi
  [ -n "$node" ] || node="YOUR_NODE"
  group="ClaudeAI"
  if [ -f "$CONFIG_FILE" ]; then
    group="$(jq -r '.mihomo.group // "ClaudeAI"' "$CONFIG_FILE" 2>/dev/null || printf 'ClaudeAI')"
    [ -n "$group" ] || group="ClaudeAI"
  fi

  cat <<EOF
建议 Clash 片段（未写入任何配置文件或订阅）:
# 把节点名换成 ClaudeAI 组里唯一允许的出口。不要把 DIRECT 或其他机场节点放进该组。
proxy-groups:
  - name: ${group}
    type: select
    proxies:
      - ${node}
      - REJECT

tun:
  enable: true
  stack: gvisor
  auto-route: true
  strict-route: true
  dns-hijack:
    - any:53

rules:
  - DOMAIN-SUFFIX,anthropic.com,${group}
  - DOMAIN-SUFFIX,claude.ai,${group}
  - DOMAIN-SUFFIX,claude.com,${group}
  - DOMAIN-SUFFIX,claudeusercontent.com,${group}
  - DOMAIN-SUFFIX,claudemcpcontent.com,${group}
  - DOMAIN,platform.claude.com,${group}
  - DOMAIN,sso.claude.com,${group}
  - DOMAIN,mcp-proxy.anthropic.com,${group}
  - DOMAIN,downloads.claude.ai,${group}
  - DOMAIN,http-intake.logs.us5.datadoghq.com,${group}
  - DOMAIN,browser-intake-us5-datadoghq.com,${group}
  - PROCESS-NAME,Claude,${group}
  - PROCESS-NAME,claude,${group}
EOF
}

report_desktop() {
  local line pid command app_count bundled_count proxy_port bundle_root dir base
  local login_out login_pid waited conn_note

  printf '桌面端:\n'
  app_count=0
  bundled_count=0
  proxy_port="${CLAUDE_PROXY_URL##*:}"
  proxy_port="${proxy_port%%/*}"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    pid="${line%% *}"
    command="${line#"$pid"}"
    command="${command#" "}"
    case "$command" in
      *Claude.app/Contents/MacOS/Claude*)
        app_count=$((app_count + 1))
        printf '  Claude.app 进程: pid=%s\n' "$pid"
        if command -v lsof >/dev/null 2>&1; then
          if lsof -nP -p "$pid" -iTCP -sTCP:ESTABLISHED 2>/dev/null | grep -F ":${proxy_port}" >/dev/null; then
            printf '  连接: pid=%s 观察到混合端口 %s\n' "$pid" "$proxy_port"
          else
            printf '  连接: pid=%s 未观察到混合端口 %s。TUN 开启时 lsof 仍可能显示公网地址，需对照 mihomo connections。\n' "$pid" "$proxy_port"
          fi
        fi
        ;;
      *"/Claude/claude-code/"*)
        bundled_count=$((bundled_count + 1))
        printf '  捆绑 claude-code 进程: pid=%s\n' "$pid"
        if command -v lsof >/dev/null 2>&1; then
          if lsof -nP -p "$pid" -iTCP -sTCP:ESTABLISHED 2>/dev/null | grep -F ":${proxy_port}" >/dev/null; then
            printf '  连接: pid=%s 观察到混合端口 %s\n' "$pid" "$proxy_port"
          else
            printf '  连接: pid=%s 未观察到混合端口 %s。\n' "$pid" "$proxy_port"
          fi
        fi
        ;;
    esac
  done <<EOF
$(ps -axo pid=,command= 2>/dev/null || true)
EOF
  if [ "$app_count" -eq 0 ]; then
    printf '  Claude.app: 未发现进程\n'
  fi
  if [ "$bundled_count" -eq 0 ]; then
    printf '  捆绑 claude-code 进程: 未发现\n'
  fi

  bundle_root="${HOME}/Library/Application Support/Claude/claude-code"
  if [ -d "$bundle_root" ]; then
    for dir in "$bundle_root"/*; do
      [ -d "$dir" ] || continue
      base="$(basename "$dir")"
      printf '  已安装捆绑版本: %s\n' "$base"
    done
  else
    printf '  已安装捆绑版本: 未发现桌面端 claude-code 目录\n'
  fi

  if [ "$(uname -s)" != "Darwin" ]; then
    printf '  登录项: 当前不是 macOS，跳过。请在 Mac 上查看系统设置 → 通用 → 登录项与扩展。\n'
  elif ! command -v osascript >/dev/null 2>&1; then
    printf '  登录项: 无 osascript。请手动查看系统设置 → 通用 → 登录项与扩展。\n'
  else
    login_out="$(mktemp)"
    osascript -e 'tell application "System Events" to get the name of every login item' >"$login_out" 2>&1 &
    login_pid=$!
    waited=0
    while [ "$waited" -lt 20 ]; do
      if ! kill -0 "$login_pid" 2>/dev/null; then
        break
      fi
      sleep 0.1
      waited=$((waited + 1))
    done
    if kill -0 "$login_pid" 2>/dev/null; then
      kill "$login_pid" 2>/dev/null || true
      wait "$login_pid" 2>/dev/null || true
      printf '  登录项: 查询超时。Claude.app 的 Start at login 使用 SMAppService，不一定出现在传统登录项里。\n'
    else
      wait "$login_pid" 2>/dev/null || true
      if grep -qi 'Claude' "$login_out" 2>/dev/null; then
        printf '  登录项: 传统登录项里有 Claude。开机时它可能早于 Clash。\n'
      else
        printf '  登录项: 传统登录项里没有 Claude。应用内 Start at login 仍可能通过 SMAppService 生效。\n'
      fi
    fi
    rm -f "$login_out"
  fi

  if [ -n "${MIHOMO_CONN_JSON:-}" ] && [ -f "$MIHOMO_CONN_JSON" ]; then
    conn_note="$(jq -r '
      (.connections // [])
      | map(select(
          ((.metadata.processPath // "") | test("Claude.app|claude-code"; "i"))
          or ((.metadata.process // "") | test("Claude|claude"; "i"))
        ))
      | if length == 0 then "none"
        else map(
          ((.metadata.process // "process") + " " + (.metadata.host // .metadata.destinationIP // "?")
            + " via " + ((.chains // []) | join(">")))
        ) | join("; ")
        end
    ' "$MIHOMO_CONN_JSON" 2>/dev/null || printf 'unparsed')"
    printf '  mihomo 连接: %s\n' "$conn_note"
    rm -f "$MIHOMO_CONN_JSON"
  fi

  printf '  开机竞态: 本工具不修改登录项。Claude 若早于 Clash 启动，可关闭 Start at login，或打开 tun.strict-route，或等 doctor 通过后再打开桌面端。\n'
}

report_doctor_environment() {
  [ "$DOCTOR_ENV_REPORTED" -eq 0 ] || return 0
  DOCTOR_ENV_REPORTED=1
  printf '\n'
  report_mihomo
  report_desktop
  print_clash_snippet
  printf '\n'
}

fail_network() {
  local code="$1"

  if [ "$COMMAND_MODE" = "doctor" ]; then
    report_doctor_environment || true
  fi
  exit "$code"
}

case "$COMMAND_MODE" in
  status)
    print_status_report
    exit 0
    ;;
  diagnose)
    print_diagnostic_report
    exit 0
    ;;
esac

if [ ! -f "$CONFIG_FILE" ]; then
  printf 'IP 安全配置不存在: %s\n' "$CONFIG_FILE" >&2
  printf '请创建配置，例如 {"command":"/path/to/claude","allowed_ips":["x.x.x.x"],"allowed_cidrs":["x.x.x.0/24"]}\n' >&2
  exit 2
fi

validate_json_file "$CONFIG_FILE" "IP 安全配置"
resolve_notification_setting 1
CLAUDE_BIN="$(jq -r '.command // empty' "$CONFIG_FILE")"
OFFICIAL_CONFIG_DIR="$(jq -r '.config_dir // empty' "$CONFIG_FILE")"
[ -n "$OFFICIAL_CONFIG_DIR" ] || OFFICIAL_CONFIG_DIR="$HOME/.claude-official"
if [ -n "$OFFICIAL_SETTINGS_OVERRIDE" ]; then
  OFFICIAL_SETTINGS="$OFFICIAL_SETTINGS_OVERRIDE"
else
  OFFICIAL_SETTINGS="$OFFICIAL_CONFIG_DIR/settings.json"
fi
if [ -z "$CLAUDE_BIN" ]; then
  printf '配置中的 command 不能为空。\n' >&2
  exit 2
fi
case "$CLAUDE_BIN" in
  /*) ;;
  *)
    printf '配置中的 command 必须是原始 Claude CLI 的绝对路径，不能写成: %s\n' "$CLAUDE_BIN" >&2
    exit 2
    ;;
esac
case "$OFFICIAL_CONFIG_DIR" in
  /*) ;;
  *)
    printf '配置中的 config_dir 必须是绝对路径: %s\n' "$OFFICIAL_CONFIG_DIR" >&2
    exit 2
    ;;
esac
if [ "$CLAUDE_BIN" = "$0" ]; then
  printf '配置中的 command 指向了 claude-guard 自己，会造成递归调用: %s\n' "$CLAUDE_BIN" >&2
  exit 2
fi
if [ ! -x "$CLAUDE_BIN" ]; then
  printf '配置中的 command 不存在或不可执行: %s\n' "$CLAUDE_BIN" >&2
  exit 2
fi

if [ ! -f "$CA_CERT_FILE" ]; then
  printf '系统 CA bundle 不存在，已拒绝启动: %s\n' "$CA_CERT_FILE" >&2
  exit 2
fi

resolve_strict_lifecycle
resolve_watchdog_strict

ui_header

ui_step_start "配置与生命周期"
check_official_settings_policy
ui_step_finish

ui_step_start "项目与参数边界"
check_project_settings_policy
check_cli_policy "$@"
check_model_policy "$@"
ui_step_finish

ui_step_start "客户端身份与指纹"
check_client_identity "$CLAUDE_BIN"
check_legacy_profile_contamination
check_client_fingerprint_tripwire "$CLAUDE_BIN"
ui_step_finish

ui_step_start "出口 IP 获取"
attempt=1
CURRENT_IP=''
while [ "$attempt" -le "$IP_CHECK_RETRIES" ]; do
  if CURRENT_IP="$(get_current_ip_once)" && [ -n "$CURRENT_IP" ]; then
    break
  fi
  if [ "$attempt" -lt "$IP_CHECK_RETRIES" ]; then
    ui_warn 'IP 检查重试：第 %s/%s 次无法从任一 IP 源获取有效 IPv4。' "$attempt" "$IP_CHECK_RETRIES"
    sleep 1
  fi
  attempt=$((attempt + 1))
done
if [ -z "$CURRENT_IP" ]; then
  printf 'IP 检查失败：无法获取当前出口 IP。\n' >&2
  printf '探测路径：%s 经由代理 %s。\n' "$IP_CHECK_URLS" "$CLAUDE_PROXY_URL" >&2
  printf '新的启动已被拒绝。默认不会结束已经在跑的后台会话。\n' >&2
  write_launch_block "exit IP check unavailable" "block-new-launches"
  fail_network 3
fi
ui_visual_note '出口 IP 已获取：%s' "$CURRENT_IP"
ui_step_finish

ui_step_start "Anthropic API TLS"
ui_note 'Claude Official 网络路径：%s，NO_PROXY=%s' "$CLAUDE_PROXY_URL" "$NO_PROXY_LIST"
check_tls_host api.anthropic.com
ui_step_finish

ui_step_start "Claude 登录 TLS"
check_tls_host platform.claude.com "$PLATFORM_TLS_MODE"
ui_step_finish

ui_step_start "IPv6 泄漏"
check_anthropic_ipv6_blocked
ui_step_finish

ui_step_start "出口白名单"
if is_allowed_ip "$CURRENT_IP"; then
  ui_note 'IP 检查通过：%s' "$CURRENT_IP"
  ui_note '出口探测与 API 同路径：%s 经由 %s' "${CURRENT_IP_SOURCE:-$IP_CHECK_URLS}" "$CLAUDE_PROXY_URL"
  clear_launch_block
  ui_step_finish
  ui_finish
  if [ "$COMMAND_MODE" = "doctor" ] || [ "${CLAUDE_GUARD_MIHOMO:-auto}" = "on" ]; then
    report_doctor_environment
  fi
  if [ "$LIFECYCLE_BLOCK" = "1" ]; then
    printf '生命周期策略未满足（CLAUDE_GUARD_STRICT_LIFECYCLE=1），网络检查已完成，已拒绝启动。\n' >&2
    exit 13
  fi
  if [ "$DOCTOR_BLOCK" = "1" ]; then
    printf 'mihomo 严格检查未通过，已拒绝启动。网络出口检查本身已完成。\n' >&2
    exit 15
  fi
  if [ "$PRECHECK_ONLY" = "1" ]; then
    if [ "$COMMAND_MODE" = "doctor" ]; then
      printf 'Doctor result: PASS (Claude was not started)\n'
      print_status_report
    elif [ "$UI_ENABLED" -eq 1 ]; then
      printf '  %sprecheck-only：未启动 Claude。%s\n' "$UI_DIM" "$UI_RESET" >&2
    else
      printf '预检完成：未启动 Claude。\n'
    fi
    exit 0
  fi
  if [ "$ASSUME_YES" != "1" ]; then
    printf '按回车继续执行 Claude Official，或按 Ctrl+C 取消。'
    read -r _
  fi
else
  allowed_display="$(jq -r '[(.allowed_ips // [])[], (.allowed_cidrs // [])[]] | join(", ")' "$CONFIG_FILE")"
  printf 'IP 检查失败：%s\n' "$CURRENT_IP" >&2
  printf '出口与白名单不一致：探测到 %s，允许 %s。\n' "$CURRENT_IP" "$allowed_display" >&2
  printf '探测使用与 API 相同的路径：%s 经由代理 %s。\n' "${CURRENT_IP_SOURCE:-$IP_CHECK_URLS}" "$CLAUDE_PROXY_URL" >&2
  printf '正在使用未授权的网络环境。\n' >&2
  printf '新的启动已被拒绝。默认不会结束已经在跑的后台会话。\n' >&2
  printf 'v%s 不提供 unsafe 绕过；已退出，未启动 Claude Official。\n' "$VERSION" >&2
  write_launch_block "exit IP not allowed ip=${CURRENT_IP}" "block-new-launches"
  fail_network 4
fi

start_watchdog_sidecar
exec_claude "$@"
